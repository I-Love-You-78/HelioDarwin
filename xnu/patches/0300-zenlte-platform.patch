diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..6c72ebc 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -79,6 +79,7 @@ pe_init_fiq()
 	int error;
 	DTEntry entry;
 
+
 	// gicd_base is 0x0 only before it's initialized by the boot processor.
 	// Avoid calling SecureDT* routines on secondary processors to avoid
 	// race conditions because they are not thread-safe.
@@ -222,9 +223,55 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
-#else
+#elif !defined(ARM64_BOARD_CONFIG_ZENLTE)
 void
 pe_init_fiq()
 {
 }
 #endif
+
+#ifdef ARM64_BOARD_CONFIG_ZENLTE
+/*
+ * Samsung Exynos 7420 (Galaxy S6 / S6 Edge / S6 Edge+ / Note 5): GIC-400.
+ *
+ * A GICv2 part, so none of the GICv3 work above applies: no redistributors
+ * to wake, no ICC_* system registers, and no ARE_NS / EnableGrp1A bits. The
+ * whole initialisation is a few memory-mapped writes at fixed physical
+ * addresses taken from the vendor device tree (exynos7420.dtsi).
+ *
+ * Group 0 belongs to TrustZone. The boot loader hands the SoC to us at EL1
+ * with the secure side configured, and non-secure writes to Group 0 are
+ * ignored, so this only ever touches Group 1 - which then arrives as a normal
+ * IRQ (see sleh_irq in osfmk/arm64/sleh.c).
+ */
+void
+pe_init_fiq()
+{
+	/* Distributor (0x11001000): forward Group 1. */
+	zenlte_gicd_write32(ZENLTE_GICD_CTLR,
+	    zenlte_gicd_read32(ZENLTE_GICD_CTLR) | ZENLTE_GICD_CTLR_ENABLEGRP1);
+
+	/*
+	 * CPU interface (0x11002000), banked per core: Group 1 on, split EOI
+	 * off so one EOIR write ends the interrupt, binary point 0, and a
+	 * priority mask that lets every priority through.
+	 */
+	zenlte_gicc_write32(ZENLTE_GICC_CTLR,
+	    (zenlte_gicc_read32(ZENLTE_GICC_CTLR) & ~ZENLTE_GICC_CTLR_EOIMODE)
+	    | ZENLTE_GICC_CTLR_ENABLEGRP1);
+	zenlte_gicc_write32(ZENLTE_GICC_BPR, 0);
+	zenlte_gicc_write32(ZENLTE_GICC_PMR, 0xFF);
+
+	/*
+	 * SGIs and PPIs share the low 32-bit bank of both ISENABLER0 and the
+	 * priority registers, and a write lands in this core's bank. Enable
+	 * the timer PPI and the IPI SGI.
+	 */
+	zenlte_gicd_write32(ZENLTE_GICD_IPRIORITYR + (ZENLTE_VTIMER_INTID & ~3U),
+	    0xA0A0A0A0);
+	zenlte_gicd_write32(ZENLTE_GICD_ISENABLER,
+	    (1U << ZENLTE_VTIMER_INTID) | (1U << ZENLTE_IPI_SGI));
+
+	__builtin_arm_isb(ISB_SY);
+}
+#endif /* ARM64_BOARD_CONFIG_ZENLTE */
