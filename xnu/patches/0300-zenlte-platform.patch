+#
+######################################################################
+#
+# zenlte (Galaxy S6 Edge+, Exynos 7420): the open-source arm64 assembly and
+# pmap, exactly like MASTER.arm64.sweet and for the same reason - Apple's own
+# SoC configs link those from the KDK's closed lib<SOC>.os.<CONFIG>.a, which
+# is arm64e and Apple-silicon specific.
+#
+# Without these two options every osfmk/arm64/*.s file is dropped from the
+# build (files.arm64 gates them on `optional nos_arm_asm` / `optional
+# nos_arm_pmap`), and the link fails on 271 references: the cache
+# maintenance primitives (CleanPoC_Dcache, FlushPoC_DcacheRegion,
+# InvalidatePoU_Icache...), the context switch and exception vectors
+# (Idle_context, ResetHandlerData, arm64_thread_exception_return), the
+# copyin/copyout fast paths and __start itself.
+#
+options		NOS_ARM_ASM		# <nos_arm_asm>
+options		NOS_ARM_PMAP		# <nos_arm_pmap>
+
+#
+######################################################################
+#
+machine		"arm64"						# <arm64>
+
+makeoptions	OSFMK_MACHINE = "arm64"				# <mach>
+
+options		COUNT_SYSCALLS		# count bsd system calls 	# <countcalls>
+options     TRASH_VFP_ON_SAVE   # <debug,trash_vfp>
+options		ALTERNATE_DEBUGGER	# <alternate_debugger>
+
+options   CONFIG_VNODES=1024		# <xsmall>
+
+options   CONFIG_FREEZE_SUSPENDED_MIN=4		# <xsmall>
+
+options	  CONFIG_MACH_APPROXIMATE_TIME
+
+options   CONFIG_KERNEL_INTEGRITY		# <kernel_integrity>
+
+options CONFIG_MACF_LAZY_VNODE_LABELS   # Turn on labels, don't preallocate
+
+options CONFIG_HYPERVISOR_PUBLIC   # unrestricted entitlement for hypervisor
+
+options   CONFIG_RESLIDE_SHARED_CACHE		# <reslide_shared_cache>
+options   CONFIG_KERNEL_TBI		# <kernel_tbi>
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 41227c3..893de2a 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -234,6 +234,23 @@ SweetCPU::signalCPU(IOCPU *target)
 	if (aff0 >= 16) {
 		panic("SWEET CPU: SGI target requires unsupported range selector");
 	}
+#if defined(ZENLTE) && defined(HAS_GIC_V2)
+	/*
+	 * GIC-400: there is no ICC_SGI1R_EL1 here. That is a GICv3 system
+	 * register, and executing it on a GICv2 part raises an
+	 * undefined-instruction exception. Software generated interrupts go
+	 * through the distributor's GICD_SGIR instead:
+	 *   [25:24] target list filter, 0b10 = the CPUs named in the mask
+	 *   [23:16] target CPU mask, used with that filter; a single Aff0 here
+	 *   [15]    NSATT, 0, so the interrupt stays in the kernel's group
+	 *   [3:0]   the SGI number
+	 */
+	uint32_t sgir = (0x2u << 24) | (1u << aff0) |
+	    ((uint32_t)ZENLTE_IPI_SGI & 0xf);
+	__builtin_arm_dsb(DSB_ISHST);
+	zenlte_gicd_write32(ZENLTE_GICD_SGIR, sgir);
+	__builtin_arm_isb(ISB_SY);
+#else
 	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
 	    (((mpidr >> 16) & 0xff) << 32) |
 	    (((mpidr >> 8) & 0xff) << 16) |
@@ -241,6 +258,7 @@ SweetCPU::signalCPU(IOCPU *target)
 	__builtin_arm_dsb(DSB_ISHST);
 	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
 	__builtin_arm_isb(ISB_SY);
+#endif
 }
 
