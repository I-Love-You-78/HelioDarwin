index fee661e..1eeccbd 100644
--- a/pexpert/pexpert/arm64/board_config.h
+++ b/pexpert/pexpert/arm64/board_config.h
@@ -108,6 +108,29 @@
 
 #endif  /* ARM64_BOARD_CONFIG_SWEET */
 
+#ifdef ARM64_BOARD_CONFIG_ZENLTE
+/*
+ * Samsung Galaxy S6 Edge+ (SM-G928F) and the other Exynos 7420 boards: four
+ * Cortex-A57 plus four Cortex-A53, ARMv8.0-A, GIC-400.
+ *
+ * This is its own machine config, not a variant of SWEET. SWEET is the
+ * Qualcomm SM7150 / MediaTek MT6789 family: GICv3, homogeneous SMP, and about
+ * 9000 lines of drivers that poke fixed physical addresses belonging to
+ * unrelated hardware on an Exynos. What this board shares with that family is
+ * the userspace-facing IOKit surface (SweetSurface, SweetPlatformExpert),
+ * which is reached by defining SWEET in ZENLTE.h rather than by building
+ * the SWEET board itself.
+ */
+#include <pexpert/arm64/ZENLTE.h>
+
+#define MAX_L2_CLINE                   6
+#define MAX_CPUS                       8
+#define MAX_CPU_CLUSTERS               2  /* A57 cluster + A53 cluster */
+
+#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
+
+#endif  /* ARM64_BOARD_CONFIG_ZENLTE */
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
