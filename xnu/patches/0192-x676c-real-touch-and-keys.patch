diff --git a/bsd/dev/sweet_touch_mtk.inc b/bsd/dev/sweet_touch_mtk.inc
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_touch_mtk.inc
@@ -0,0 +1,332 @@
+/*
+ * X676C FT5452J (ft3519_common.ko), I2C0 address 0x38.
+ * The runtime FDT specifies GPIO9 IRQ, GPIO152 reset, GPIO62 power,
+ * five contacts and 0..1079 x 0..2399 coordinates. The vendor's
+ * fts_irq_handler reads 32 bytes at register 1, not the Topaz format.
+ *
+ * i2c-mt65xx.ko's mt6983_compat uses the v2 table with SLAVE_ADDR 0x94,
+ * a 16-byte FIFO, APDMA v1 and 36-bit DMA addresses. Reports use one
+ * combined DMA transfer so that a frame is not split across I2C reads.
+ * All controller accesses belong to this one thread. No firmware upload.
+ */
+#define MTK_TOUCH_CONTACTS    5u
+#define MTK_TOUCH_REPORT_LEN  32u
+#define MTK_TOUCH_RX_OFFSET   128u
+
+#define MTKI_INTR_STAT        0x0cu
+#define MTKI_CONTROL          0x10u
+#define MTKI_TRANSFER_LEN     0x14u
+#define MTKI_TRANSAC_LEN      0x18u
+#define MTKI_START            0x24u
+#define MTKI_FIFO_CLR         0x38u
+#define MTKI_AUX_LEN          0x44u
+#define MTKI_SOFTRESET        0x50u
+#define MTKI_SLAVE_ADDR       0x94u
+#define MTKI_COMPLETE         1u
+#define MTKI_ERRORS           6u
+
+static struct {
+	vm_offset_t i2c, dma, gpio, rt, lm, clock, infra, impw, memory;
+	uint64_t physical;
+	bool dma_quiet;
+} mt;
+
+static uint16_t
+mtki_read(unsigned offset)
+{
+	uint16_t value = *(volatile uint16_t *)(mt.i2c + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+mtki_write(unsigned offset, uint16_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint16_t *)(mt.i2c + offset) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+mtki_dma_idle(void)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(sweet_input_read32(mt.dma, 8) & 1u)) {
+			mt.dma_quiet = true;
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+mtki_reset(void)
+{
+	/* APDMA warm/handshake reset sequence from mtk_i2c_init_hw. */
+	sweet_input_write32(mt.dma, 0x0c, 1);
+	delay(10);
+	sweet_input_write32(mt.dma, 0x0c, 0);
+	delay(10);
+	sweet_input_write32(mt.dma, 0x0c, 6);
+	mtki_write(MTKI_SOFTRESET, 0x21);
+	delay(10);
+	sweet_input_write32(mt.dma, 0x0c, 0);
+	mtki_write(MTKI_SOFTRESET, 0);
+	if (!mtki_dma_idle()) {
+		st.dead = true;
+		return false;
+	}
+	mtki_write(0x08, 0);             /* poll status, no GIC interrupt */
+	mtki_write(MTKI_INTR_STAT, 0x1f);
+	mtki_write(0x34, 3);             /* open-drain SDA/SCL */
+	mtki_write(0x48, 0);             /* input clock divider = 1 */
+	mtki_write(0x30, 0);             /* high-speed mode off */
+	/* Vendor standard_mode_spec includes margins: low/setup 5200 ns,
+	 * data hold <=2950 ns and setup >=750 ns. Its timing algorithm gives
+	 * sample=3, high=41, low=47: 26 MHz / (3 * 88) = 98.5 kHz. */
+	mtki_write(0x20, 0x0228);
+	mtki_write(0x2c, 0x00ae);
+	mtki_write(0x28, 0x8901);
+	mtki_write(0x3c, 0x100c);
+	mtki_write(0x90, 0);
+	mtki_write(0x1c, 2);
+	mtki_write(MTKI_FIFO_CLR, 1);
+	if (mtki_read(0x20) != 0x0228 || mtki_read(0x2c) != 0x00ae ||
+	    mtki_read(0x28) != 0x8901 || (mtki_read(MTKI_START) & 1u)) {
+		st.dead = true;
+		return false;
+	}
+	return true;
+}
+
+static int
+mtki_read_register(uint8_t reg, uint8_t *buffer, unsigned length)
+{
+	if (!length || length > MTK_TOUCH_REPORT_LEN || !buffer || st.dead) {
+		return EINVAL;
+	}
+	bool dma = length > 16;
+	if ((mtki_read(MTKI_START) & 1u) ||
+	    (sweet_input_read32(mt.dma, 8) & 1u)) {
+		return EBUSY;
+	}
+	mtki_write(MTKI_INTR_STAT, 0x1f);
+	mtki_write(MTKI_FIFO_CLR, 1);
+	/* Write the register pointer, then repeated START into the read. */
+	mtki_write(MTKI_SLAVE_ADDR, 0x38u << 1);
+	mtki_write(MTKI_TRANSFER_LEN, 1);
+	mtki_write(MTKI_AUX_LEN, (uint16_t)length);
+	mtki_write(MTKI_TRANSAC_LEN, 2);
+	mtki_write(MTKI_CONTROL, dma ? 0x033e : 0x003a);
+	if (dma) {
+		*(uint8_t *)mt.memory = reg;
+		memset((void *)(mt.memory + MTK_TOUCH_RX_OFFSET), 0xff, length);
+		clean_dcache64(mt.physical, 64, TRUE);
+		flush_dcache64(mt.physical + MTK_TOUCH_RX_OFFSET, 64, TRUE);
+		sweet_input_write32(mt.dma, 0x00, 0); /* clear DMA status */
+		sweet_input_write32(mt.dma, 0x04, 0); /* no DMA interrupt */
+		sweet_input_write32(mt.dma, 0x18, 0x214); /* direction change, skip config */
+		sweet_input_write32(mt.dma, 0x1c, (uint32_t)mt.physical);
+		sweet_input_write32(mt.dma, 0x20, (uint32_t)(mt.physical + MTK_TOUCH_RX_OFFSET));
+		sweet_input_write32(mt.dma, 0x24, 1);
+		sweet_input_write32(mt.dma, 0x28, length);
+		sweet_input_write32(mt.dma, 0x54, (uint32_t)(mt.physical >> 32));
+		sweet_input_write32(mt.dma, 0x58, (uint32_t)((mt.physical + MTK_TOUCH_RX_OFFSET) >> 32));
+		mt.dma_quiet = false;
+		sweet_input_write32(mt.dma, 8, 1);
+	} else {
+		*(volatile uint8_t *)mt.i2c = reg;
+		__asm__ volatile("dsb osh" ::: "memory");
+	}
+	mtki_write(MTKI_START, 1);
+	int error = ETIMEDOUT;
+	for (unsigned i = 0; i < 10000; i++) {
+		uint16_t status = mtki_read(MTKI_INTR_STAT);
+		st.irq_status = status;
+		if (status & MTKI_ERRORS) {
+			error = ENXIO;
+			break;
+		}
+		if (status & MTKI_COMPLETE) {
+			if (dma) {
+				if (!mtki_dma_idle()) {
+					break;
+				}
+				flush_dcache64(mt.physical + MTK_TOUCH_RX_OFFSET, 64, TRUE);
+				memcpy(buffer, (void *)(mt.memory + MTK_TOUCH_RX_OFFSET), length);
+			} else {
+				for (unsigned j = 0; j < length; j++) {
+					buffer[j] = *(volatile uint8_t *)mt.i2c;
+					__asm__ volatile("dmb oshld" ::: "memory");
+				}
+			}
+			mtki_write(MTKI_INTR_STAT, status);
+			return 0;
+		}
+		delay(2);
+	}
+	/* Stop DMA before reusing the buffer, including an ACK error. */
+	(void)mtki_reset();
+	return error;
+}
+
+static int
+mtk_touch_report(void)
+{
+	uint8_t report[MTK_TOUCH_REPORT_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, seen = 0;
+	int error = mtki_read_register(1, report, sizeof(report));
+	if (error) {
+		return error;
+	}
+	unsigned format = report[1] >> 4, count = report[1] & 15u;
+	memcpy(st.s_raw, report, sizeof(st.s_raw));
+	st.s_frames++;
+	if ((format != 0 && format != 2) || count > MTK_TOUCH_CONTACTS) {
+		return EIO; /* includes all-FF reset/recovery frames */
+	}
+	unsigned records = format == 0 ? MTK_TOUCH_CONTACTS : count;
+	unsigned active = 0;
+	for (unsigned i = 0; i < records; i++) {
+		const uint8_t *p = report + 2 + i * 6;
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (format == 0 && id >= 10) {
+			break; /* vendor's unused-record sentinel */
+		}
+		if (id >= MTK_TOUCH_CONTACTS || (seen & (1u << id)) || event == 3) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1) {
+			continue;
+		}
+		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
+		if (px > 1079 || py > 2399) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		active++;
+	}
+	if ((format == 0 && active && !count) || (format == 2 && !count)) {
+		return EIO;
+	}
+	if (active > st.s_maxn) {
+		st.s_maxn = active;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static int
+mtk_touch_setup(void)
+{
+	mt.i2c = ml_io_map(0x11e00000u, 0x1000);
+	mt.dma = ml_io_map(0x10217000u, 0x1000);
+	mt.gpio = ml_io_map(0x10005000u, 0x1000);
+	mt.rt = ml_io_map(0x11ea0000u, 0x1000);
+	mt.lm = ml_io_map(0x11e20000u, 0x1000);
+	mt.clock = ml_io_map(0x10000000u, 0x1000);
+	mt.infra = ml_io_map(0x10001000u, 0x1000);
+	mt.impw = ml_io_map(0x11e02000u, 0x1000);
+	if (!mt.i2c || !mt.dma || !mt.gpio || !mt.rt || !mt.lm ||
+	    !mt.clock || !mt.infra || !mt.impw) {
+		return ENOMEM;
+	}
+	mt.dma += 0x80; /* runtime FDT APDMA channel for I2C0 */
+	/* Select the crystal parent; change only the shared I2C mux field. */
+	sweet_input_write32(mt.clock, 0xb8, 0x8300);
+	sweet_input_write32(mt.clock, 0x08, 1u << 10);
+	if (!touch_wait_clear(mt.clock, 0x08, 1u << 10) ||
+	    (sweet_input_read32(mt.clock, 0xb0) & 0x8300)) {
+		return ETIMEDOUT;
+	}
+	sweet_input_write32(mt.infra, 0x84, (1u << 11) | (1u << 12));
+	sweet_input_write32(mt.infra, 0xd4, 1u << 31);
+	sweet_input_write32(mt.impw, 0xe08, 1);
+	if ((sweet_input_read32(mt.infra, 0x90) & ((1u << 11) | (1u << 12))) ||
+	    (sweet_input_read32(mt.infra, 0xd8) & (1u << 31)) ||
+	    (sweet_input_read32(mt.impw, 0xe00) & 1u)) {
+		return EIO;
+	}
+	if (kmem_alloc_contig(kernel_map, &mt.memory, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t page = pmap_find_phys(kernel_pmap, (addr64_t)mt.memory);
+	mt.physical = ptoa_64(page);
+	mt.dma_quiet = true;
+	if (!page || ((mt.physical + PAGE_SIZE - 1) >> 36)) {
+		return EOVERFLOW;
+	}
+	if (!mtki_reset()) {
+		return EIO;
+	}
+	sweet_input_pin_mode(mt.gpio, 130, 1); /* SCL0 */
+	sweet_input_pin_mode(mt.gpio, 131, 1); /* SDA0 */
+	sweet_input_write32(mt.lm, 0xd4, 1u << 29); /* GPIO130 input-enable */
+	sweet_input_write32(mt.lm, 0xe4, 1u << 3);  /* GPIO131 input-enable */
+	sweet_input_pin_mode(mt.gpio, 9, 0);
+	sweet_input_write32(mt.gpio, 8, 1u << 9); /* IRQ input */
+	sweet_input_write32(mt.rt, 0x84, 1); /* GPIO9 input-enable */
+	sweet_input_pin_mode(mt.gpio, 62, 0);
+	sweet_input_pin_output(mt.gpio, 62, true);
+	sweet_input_pin_mode(mt.gpio, 152, 0);
+	sweet_input_pin_output(mt.gpio, 152, false);
+	touch_wait(1);
+	sweet_input_pin_output(mt.gpio, 152, true);
+	touch_wait(200);
+	uint8_t high = 0, low = 0;
+	int e1 = mtki_read_register(0xa3, &high, 1);
+	int e2 = mtki_read_register(0x9f, &low, 1);
+	printf("SWEET TOUCH: X676C I2C0 FT5452J id=%02x:%02x err=%d/%d irq=%u\n",
+	    high, low, e1, e2, sweet_input_pin_high(mt.gpio, 9));
+	if (e1 || e2) {
+		return e1 ? e1 : e2;
+	}
+	return high == 0x54 && low == 0x52 ? 0 : ENODEV;
+}
+
+static void
+mtk_touch_run(void)
+{
+	st.stage = "X676C setup";
+	int error = mtk_touch_setup();
+	if (error) {
+		printf("SWEET TOUCH: X676C setup failed error=%d; no controller selected\n", error);
+		goto out;
+	}
+	st.stage = "X676C polling";
+	printf("SWEET TOUCH: FT5452J, five contacts, 1080x2400, poll=10ms\n");
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		/* GPIO hint plus a periodic read recovers a missed edge or release. */
+		if (st.active || !sweet_input_pin_high(mt.gpio, 9) || (++ticks % 10u) == 0) {
+			error = mtk_touch_report();
+			if (error) {
+				st.s_errs++;
+				st.s_lasterr = error;
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: X676C report error=%d status=%#x\n", error, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y);
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	if (mt.memory && mt.dma_quiet) {
+		kmem_free(kernel_map, mt.memory, PAGE_SIZE);
+		mt.memory = 0;
+	}
+	/* A buffer whose DMA engine failed to stop must remain wired. */
+}
