+/* Opt-in sample of one partition-relative byte range after read completion. */
+static void
+ufs_disk_read_trace(const struct ufs_part *p, uint64_t off, caddr_t va,
+    uint32_t len, int error)
+{
+	uint64_t words[8];
+	uint64_t target = ud.read_trace_offset;
+	if (!ud.read_trace_enabled || strcmp(p->name, ud.read_trace_part) ||
+	    target < off || target - off > len || sizeof(words) > len - (target - off)) {
+		return;
+	}
+	if (os_atomic_inc_orig(&ud.read_trace_count, relaxed) >= 8) {
+		return;
+	}
+	vm_offset_t sample = (vm_offset_t)(va + (target - off));
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sample);
+	uint64_t pa = pn ? ptoa_64(pn) | (sample & PAGE_MASK) : 0;
+	memcpy(words, (const void *)sample, sizeof(words));
+	printf("UFSREAD %s off 0x%llx len 0x%x target 0x%llx error %d pa 0x%llx "
+	    "%016llx %016llx %016llx %016llx %016llx %016llx %016llx %016llx\n",
+	    p->name, off, len, target, error, pa, words[0], words[1], words[2], words[3],
+	    words[4], words[5], words[6], words[7]);
+}
