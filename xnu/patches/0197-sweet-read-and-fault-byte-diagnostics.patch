+/* Match an unslid address from a boot argument, independent of ASLR. */
+static void
+sweet_crash_fault_bytes(const char *name, uint64_t far, uint64_t slide)
+{
+	static unsigned samples;
+	uint64_t target;
+	uint64_t words[8] = { 0 };
+	if (!PE_parse_boot_argn("sweetfaultaddr", &target, sizeof(target)) || far < slide ||
+	    ((far - slide) & ~63ull) != (target & ~63ull)) {
+		return;
+	}
+	if (os_atomic_inc_orig(&samples, relaxed) >= 8) {
+		return;
+	}
+	uint64_t addr = far & ~63ull;
+	vm_map_offset_t region = addr;
+	vm_map_size_t size = 0;
+	natural_t depth = 64;
+	vm_region_submap_info_data_64_t info;
+	mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_V2_COUNT_64;
+	kern_return_t kr = vm_map_region_recurse_64(current_map(), &region, &size, &depth,
+	    (vm_region_submap_info_64_t)&info, &count);
+	if (kr == KERN_SUCCESS) {
+		printf("FAULTMAP %s base 0x%llx size 0x%llx offset 0x%llx prot %d/%d "
+		    "share %d submap %d depth %u\n", name, (uint64_t)region, (uint64_t)size,
+		    (uint64_t)info.offset, info.protection, info.max_protection,
+		    info.share_mode, info.is_submap, depth);
+	} else {
+		printf("FAULTMAP %s error %d\n", name, kr);
+	}
+	ppnum_t before = pmap_find_phys(current_map()->pmap, addr);
+	int error = copyin((user_addr_t)addr, words, sizeof(words));
+	ppnum_t after = pmap_find_phys(current_map()->pmap, addr);
+	printf("FAULTBYTES %s va 0x%llx unslid 0x%llx error %d ppn 0x%x/0x%x "
+	    "%016llx %016llx %016llx %016llx %016llx %016llx %016llx %016llx\n",
+	    name, addr, addr - slide, error, before, after,
+	    words[0], words[1], words[2], words[3], words[4], words[5], words[6], words[7]);
+}
+
