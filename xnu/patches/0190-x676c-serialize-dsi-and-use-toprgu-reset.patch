 extern int sync_internal(void);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static bool
+sweet_diagnostic_reset_supported(void)
+{
+	static const char board[] = "infinix,x676c";
+	DTEntry root;
+	const void *property;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &property, &size) != kSuccess) {
+		return false;
+	}
+	const char *compatible = property;
+	for (unsigned int i = 0; i + sizeof(board) <= size; i++) {
+		if ((i == 0 || compatible[i - 1] == '\0') &&
+		    memcmp(compatible + i, board, sizeof(board)) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
 
