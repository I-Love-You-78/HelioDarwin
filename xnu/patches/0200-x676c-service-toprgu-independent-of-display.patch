 bool
+AppleCLCD::startWatchdog(void)
+{
+	if (!sweet_board_x676c()) {
+		return true;
+	}
+	IOMemoryDescriptor *memory = IOMemoryDescriptor::withPhysicalAddress(
+	    0x10007000, 0x1000, kIODirectionInOut);
+	fWdtMap = memory != NULL ? memory->map(kIOMapAnywhere | kIOMapInhibitCache) : NULL;
+	OSSafeReleaseNULL(memory);
+	if (fWdtMap == NULL || fWdtMap->getLength() < 0x18 || fWdtMap->getVirtualAddress() == 0) {
+		IOLog("SWEET TOPRGU: heartbeat MMIO mapping failed\n");
+		stopWatchdog();
+		return false;
+	}
+	fWdtRegisters = (volatile uint32_t *)(uintptr_t)fWdtMap->getVirtualAddress();
+	uint32_t mode = mtk_display_read(fWdtRegisters, 0x00);
+	uint32_t length = mtk_display_read(fWdtRegisters, 0x04);
+	uint32_t status = mtk_display_read(fWdtRegisters, 0x0c);
+	/* LENGTH[15:5] counts 1/64-second units; vendor seconds use << 11.
+	 * Never change the inherited MODE, LENGTH, or reset/status registers. */
+	uint32_t counts = (length & 0xffe0u) >> 5;
+	if (mode == UINT32_MAX || length == UINT32_MAX || ((mode & 1u) && counts == 0)) {
+		IOLog("SWEET TOPRGU: invalid inherited mode %#x length %#x status %#x\n",
+		    mode, length, status);
+		stopWatchdog();
+		return false;
+	}
+	fWdtTimeoutUS = counts * 1000000u / 64u;
+	fWdtIntervalUS = (mode & 1u) ? fWdtTimeoutUS / 4u : 1000000u;
+	if (fWdtIntervalUS > 1000000u) {
+		fWdtIntervalUS = 1000000u;
+	}
+	mtk_display_write(fWdtRegisters, 0x08, 0x1971);
+	fWdtLastService = mach_absolute_time();
+	fWdtServices = 1;
+	IOLog("SWEET TOPRGU: inherited mode %#x length %#x status %#x; enabled %u timeout_us %u heartbeat_us %u\n",
+	    mode, length, status, mode & 1u, fWdtTimeoutUS, fWdtIntervalUS);
+	fWdtWorkLoop = IOWorkLoop::workLoop();
+	fWdtTimer = IOTimerEventSource::timerEventSource(this, &AppleCLCD::watchdogFired);
+	if (fWdtWorkLoop == NULL || fWdtTimer == NULL ||
+	    fWdtWorkLoop->addEventSource(fWdtTimer) != kIOReturnSuccess) {
+		IOLog("SWEET TOPRGU: heartbeat event setup failed; inherited watchdog unchanged\n");
+		stopWatchdog();
+		return false;
+	}
+	fWdtAttached = true;
+	if (fWdtTimer->setTimeoutUS(fWdtIntervalUS) != kIOReturnSuccess) {
+		IOLog("SWEET TOPRGU: initial heartbeat scheduling failed\n");
+		stopWatchdog();
+		return false;
+	}
+	return true;
+}
+
+void
+AppleCLCD::watchdogFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint64_t now = mach_absolute_time(), elapsed_ns;
+	mtk_display_write(fb->fWdtRegisters, 0x08, 0x1971);
+	absolutetime_to_nanoseconds(now - fb->fWdtLastService, &elapsed_ns);
+	fb->fWdtLastService = now;
+	if (fb->fWdtServices < 4) {
+		IOLog("SWEET TOPRGU: heartbeat %u gap_us %llu inherited_timeout_us %u\n",
+		    ++fb->fWdtServices, elapsed_ns / NSEC_PER_USEC, fb->fWdtTimeoutUS);
+	}
+	if (sender->setTimeoutUS(fb->fWdtIntervalUS) != kIOReturnSuccess) {
+		IOLog("SWEET TOPRGU: heartbeat rearm failed; service stopped\n");
+	}
+}
+
+IOReturn
+AppleCLCD::stopWatchdogAction(OSObject *owner, void *, void *, void *, void *)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	/* runAction serializes with timer MMIO users and invalidates queued calls. */
+	fb->fWdtTimer->disable();
+	fb->fWdtTimer->cancelTimeout();
+	return kIOReturnSuccess;
+}
+
+void
+AppleCLCD::stopWatchdog(void)
+{
+	if (fWdtTimer != NULL) {
+		if (fWdtAttached) {
+			(void)fWdtWorkLoop->runAction(&AppleCLCD::stopWatchdogAction, this);
+			fWdtWorkLoop->removeEventSource(fWdtTimer);
+			fWdtAttached = false;
+		} else {
+			fWdtTimer->disable();
+			fWdtTimer->cancelTimeout();
+		}
+		OSSafeReleaseNULL(fWdtTimer);
+	}
+	OSSafeReleaseNULL(fWdtWorkLoop);
+	if (fWdtServices != 0 && fWdtMap != NULL) {
+		IOLog("SWEET TOPRGU: heartbeat removed; inherited watchdog configuration unchanged\n");
+	}
+	fWdtRegisters = NULL;
+	OSSafeReleaseNULL(fWdtMap);
+}
+
+void
+AppleCLCD::stop(IOService *provider)
+{
+	stopWatchdog();
+	IOService::stop(provider);
+}
+
+void
+AppleCLCD::free(void)
+{
+	stopWatchdog();
+	IOService::free();
+}
