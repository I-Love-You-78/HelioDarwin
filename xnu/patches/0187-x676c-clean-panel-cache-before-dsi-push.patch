From cb6a8f77da655932229c8097d0663c0fcd2aab62 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Fri, 23 Oct 2026 14:01:04 +0500
Subject: [PATCH] x676c: clean panel cache before DSI push so composited frames
 reach the screen

directPresent() bails on x676c (fVig0 == NULL), so every frame goes through the
copy path in present(), which composes the layers straight into the cached
mapping of the panel memory (fPixels) and then calls mtkDsiPush(). It never
cleaned the dcache, so the composited frame stayed in the CPU cache while the
MTK DSI/OVL fetched the stale boot-splash from DRAM -- the panel kept showing the
Apple logo even though SpringBoard was compositing and swapping (SWEET FB: swap N).
Clean fPixels out to DRAM before the push, matching flipBack()/directPresent().
---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 84914a3..7944a74 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1418,6 +1418,17 @@ AppleCLCD::present(const uint8_t *rec)
 	if (fFlip[0] != NULL) {
 		flipBack();
 	} else if (sweet_board_x676c()) {
+		/*
+		 * The layers were composed straight into the cached mapping of the panel
+		 * memory. The MTK DSI/OVL fetches the frame from DRAM, so clean the cache
+		 * out to DRAM before triggering the push -- otherwise the new frame sits
+		 * in the CPU cache and the panel keeps showing the stale boot-splash
+		 * (this is why nothing appeared past the Apple logo even though SpringBoard
+		 * was compositing and swapping).
+		 */
+		if (fPixels != 0) {
+			sweet_dcache_clean((vm_offset_t)fPixels, (unsigned)((size_t)fRowBytes * fHeight));
+		}
 		mtkDsiPush();
 	}
 }
