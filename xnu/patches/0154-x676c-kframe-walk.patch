From 004515317aae22042a3e4fb7df7223f675b16f16 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 01:30:49 +0500
Subject: [PATCH] x676c: walk frame records for a clean blocked-thread call
 chain

The raw stack scan prints every word in kernel text, mixing live return
addresses with stale ones, so the blocked-thread chain was ambiguous
(hba->lock came out innocent -- no contended print -- yet ufs_slot_put
still showed up). Add a precise pass that only prints lr from valid
{fp,lr} frame records (fp points higher up the stack, 16-byte aligned,
next word in text), giving the true wait path.
---
 osfmk/kern/exception.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index b30d1c9..b255a94 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1099,6 +1099,29 @@ sweet_sample_task(const char *name, int pid, task_t task)
 					}
 				}
 				printf("%s\n", sline);
+
+				/*
+				 * Precise pass: walk frame records on the stack. A real
+				 * {fp,lr} pair has *p pointing higher up the same stack
+				 * (16-byte aligned) with the next word in kernel text.
+				 * This filters out the stale text words the raw kscan
+				 * above prints, giving the true blocked-thread call chain.
+				 */
+				char fline[400];
+				int fn = snprintf(fline, sizeof(fline), "SMP %s t%d kframes", name, cur_tn);
+				for (uint64_t p = pscan; p >= VM_MIN_KERNEL_ADDRESS && p < stacktop &&
+				    (p - pscan) < 0x4000 && fn < (int)sizeof(fline) - 20; p += 8) {
+					uint64_t cand_fp = *(uint64_t *)p;
+					if (cand_fp <= p || cand_fp >= stacktop || (cand_fp & 15)) {
+						continue;
+					}
+					uint64_t lr = *(uint64_t *)(p + 8);
+					if (lr >= vm_kernel_stext && lr < vm_kernel_etext) {
+						fn += snprintf(fline + fn, sizeof(fline) - fn, " 0x%llx",
+						    lr - (uint64_t)vm_kernel_slide);
+					}
+				}
+				printf("%s\n", fline);
 			}
 		}
 	}
-- 
