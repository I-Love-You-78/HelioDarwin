From ab1a6d3b2d9618a22325e0260bfe654316a7a775 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 01:48:00 +0500
Subject: [PATCH] x676c: count IRQs taken and report them in the SMP sampler

Four debug cycles show the same pattern: each thread_block we remove in
the UFS path (slot_wait, then lck_mtx_lock, then slot_put) just surfaces
the next one, which means blocked threads never wake -- the hallmark of
a vtimer that is not delivering. Count total/timer/ipi/other IRQs in the
SWEET interrupt handler and print them (with mach_absolute_time) once per
sampler pass, so a flat timer count across samples proves the vtimer is
dead and justifies the GICv3 delivery bring-up.
---
 osfmk/arm64/sleh.c     | 10 ++++++++++
 osfmk/kern/exception.c |  7 +++++++
 2 files changed, 17 insertions(+)

diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index a2a8c1b..b4cf3ab 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -258,6 +258,12 @@ void cpu_signal_handler(void);
 extern unsigned int gFastIPI;
 #endif /* defined(HAS_IPI) */
 
+#if defined(SWEET)
+/* Bring-up: count IRQs taken so the sampler can tell whether the vtimer
+ * (and thus scheduler wakeups) is actually firing. */
+volatile uint64_t sweet_irq_total, sweet_irq_timer, sweet_irq_ipi, sweet_irq_other;
+#endif
+
 static arm_saved_state64_t *original_faulting_state = NULL;
 
 TUNABLE(bool, fp_exceptions_enabled, "-fp_exceptions", false);
@@ -1945,7 +1951,9 @@ sleh_irq(arm_saved_state_t *state)
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
 	}
+	sweet_irq_total++;
 	if (intid == sweet_vtimer_intid) {
+		sweet_irq_timer++;
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
 		cdp->cpu_decrementer = -1; /* Large */
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
@@ -1953,12 +1961,14 @@ sleh_irq(arm_saved_state_t *state)
 		INTERRUPT_MASKED_DEBUG_END();
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 	} else if (intid < 16) {
+		sweet_irq_ipi++;
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
 		/* Ack before handling so an IPI raised meanwhile is not lost */
 		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 		__builtin_arm_isb(ISB_SY);
 		cpu_signal_handler();
 	} else {
+		sweet_irq_other++;
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 		if (cdp->interrupt_handler) {
 			cdp->interrupt_handler(cdp->interrupt_target,
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index b255a94..c15a260 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1015,6 +1015,13 @@ sweet_sample_task(const char *name, int pid, task_t task)
 	    task->mach_header_vm_address, (uint64_t)vm_kernel_slide);
 
 	task_lock(task);
+	{
+		extern volatile uint64_t sweet_irq_total, sweet_irq_timer, sweet_irq_ipi, sweet_irq_other;
+		printf("SMP irq total=%llu timer=%llu ipi=%llu other=%llu abstime=%llu\n",
+		    sweet_irq_total, sweet_irq_timer, sweet_irq_ipi, sweet_irq_other,
+		    mach_absolute_time());
+	}
+
 	queue_iterate(&task->threads, thread, thread_t, task_threads) {
 		arm_saved_state_t *ss = find_user_regs(thread);
 		char line[400];
-- 
