+++ b/iokit/Kernel/arm/SweetMaliUserClient.inc
@@ -0,0 +1,1047 @@
+/* Mali-G57 v9 JM transport, included only by SweetFramebuffer.cpp.
+ * Register programming cross-checked with MT6789 kbase module functions:
+ * entry_set_ate 0x5ceb8, entry_set_pte 0x5cf68, mmu_update 0x5cd84,
+ * kbase_mmu_hw_configure 0x5bc24, kbase_job_hw_submit 0x504e0.
+ * No userspace MMIO or physical-address interface is provided.
+ */
+#include "SweetMaliABI.h"
+#include "SweetMaliHw.h"
+#include <kern/task.h>
+
+extern "C" int sweet_pwrap_read(uint16_t reg, uint16_t *value);
+extern "C" int sweet_pwrap_write(uint16_t reg, uint16_t value);
+
+static bool sweet_mali_enable_pmic_rails()
+{
+	/* Shipped mt6358-regulator.ko descriptors: VGPU 0x1690, VSRAM_GPU 0x3670.
+	 * gpufreq __gpufreq_power_control 0x2150 enables VGPU then VSRAM_GPU;
+	 * it does not replace the voltage selectors when powering the rails up. */
+	const uint16_t enableRegs[] = {0x1508, 0x1bc8};
+	const char *names[] = {"VGPU", "VSRAM_GPU"};
+	uint16_t selectors[2] = {};
+	bool changed = false;
+	for (unsigned i = 0; i < 2; ++i) {
+		uint16_t value = 0;
+		int error = sweet_pwrap_read(enableRegs[i], &value);
+		if (error) {
+			IOLog("SWEET GPU: %s enable read failed %d\n", names[i], error);
+			return false;
+		}
+		if (!(value & 1u)) {
+			error = sweet_pwrap_write(enableRegs[i], value | 1u);
+			if (error) {
+				IOLog("SWEET GPU: %s enable write failed %d\n", names[i], error);
+				return false;
+			}
+			changed = true;
+		}
+		error = sweet_pwrap_read(enableRegs[i], &value);
+		if (error || !(value & 1u)) {
+			IOLog("SWEET GPU: %s enable not verified error %d value 0x%04x\n", names[i],
+			      error, value);
+			return false;
+		}
+	}
+	if (changed) {
+		IODelay(500);
+	}
+	if (sweet_pwrap_read(0x1526, &selectors[0]) || sweet_pwrap_read(0x1bf4, &selectors[1])) {
+		IOLog("SWEET GPU: inherited voltage selector read failed\n");
+		return false;
+	}
+	IOLog("SWEET GPU: PMIC enables verified; inherited VGPU selector 0x%02x VSRAM_GPU 0x%02x\n",
+	      selectors[0] & 0x7f, selectors[1] & 0x7f);
+	return true;
+}
+
+class SweetMaliUserClient;
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	IOLock *gpuLock;
+	volatile uint32_t *regs;
+	SweetMaliUserClient *active;
+	IOWorkLoop *gpuWorkLoop;
+	IOTimerEventSource *gpuTimer;
+	uint32_t asUsed;
+	bool ready, fatal, railsVerified;
+	static void timerFired(OSObject *owner, IOTimerEventSource *timer);
+	bool init(OSDictionary *properties = NULL) APPLE_KEXT_OVERRIDE
+	{
+		if (!IOService::init(properties)) {
+			return false;
+		}
+		gpuLock = IOLockAlloc();
+		regs = NULL;
+		active = NULL;
+		gpuWorkLoop = NULL;
+		gpuTimer = NULL;
+		asUsed = 0;
+		ready = fatal = false;
+		railsVerified = false;
+		if (!gpuLock) {
+			return false;
+		}
+		gpuWorkLoop = IOWorkLoop::workLoop();
+		gpuTimer = IOTimerEventSource::timerEventSource(this, timerFired);
+		if (!gpuWorkLoop || !gpuTimer) {
+			return false;
+		}
+		return gpuWorkLoop->addEventSource(gpuTimer) == kIOReturnSuccess;
+	}
+	void free() APPLE_KEXT_OVERRIDE
+	{
+		if (gpuTimer) {
+			gpuTimer->cancelTimeout();
+			if (gpuWorkLoop) {
+				gpuWorkLoop->removeEventSource(gpuTimer);
+			}
+			gpuTimer->release();
+		}
+		if (gpuWorkLoop) {
+			gpuWorkLoop->release();
+		}
+		if (gpuLock) {
+			IOLockFree(gpuLock);
+		}
+		IOService::free();
+	}
+	uint32_t rd(uint32_t off)
+	{
+		uint32_t v = regs[off / 4];
+		__asm__ volatile("dmb oshld" ::: "memory");
+		return v;
+	}
+	void wr(uint32_t off, uint32_t v)
+	{
+		__asm__ volatile("dmb oshst" ::: "memory");
+		regs[off / 4] = v;
+	}
+	uint64_t rd64(uint32_t off)
+	{
+		return rd(off) | ((uint64_t)rd(off + 4) << 32);
+	}
+	void wr64(uint32_t off, uint64_t v)
+	{
+		wr(off, (uint32_t)v);
+		wr(off + 4, (uint32_t)(v >> 32));
+	}
+	bool poll(uint32_t off, uint64_t mask, uint64_t value)
+	{
+		for (unsigned i = 0; i < 10000; ++i) {
+			if ((rd64(off) & mask) == value) {
+				return true;
+			}
+			IODelay(10);
+		}
+		return false;
+	}
+	bool reset()
+	{
+		ready = false;
+		wr(MALI_REG_GPU_IRQ_MASK, 0);
+		wr(MALI_JOB_IRQ_MASK, 0);
+		wr(MALI_MMU_IRQ_MASK, 0);
+		wr(MALI_REG_GPU_IRQ_CLEAR, ~0u);
+		wr(MALI_REG_GPU_COMMAND, MALI_GPU_CMD_SOFT_RESET);
+		bool done = false;
+		for (unsigned i = 0; i < 10000; ++i) {
+			if (rd(MALI_REG_GPU_IRQ_RAWSTAT) & MALI_GPU_IRQ_RESET_COMPLETED) {
+				done = true;
+				break;
+			}
+			IODelay(10);
+		}
+		if (!done) {
+			fatal = true;
+			IOLog("SWEET GPU: soft reset timed out; device quarantined\n");
+			return false;
+		}
+		wr(MALI_REG_GPU_IRQ_CLEAR, ~0u);
+		wr(MALI_JOB_IRQ_CLEAR, ~0u);
+		wr(MALI_MMU_IRQ_CLEAR, ~0u);
+		/* MT6789 runs without CPU/GPU hardware cache coherency. */
+		wr(MALI_REG_COHERENCY_ENABLE, MALI_COHERENCY_NONE);
+		/* Exact r0p1 vendor issue/feature tables: base_hw_issues_tNAx_r0p1
+		 * 0x83998 and base_hw_features_tNAx 0x82c78; init_hw 0x49c74.
+		 * No quirks_* overrides exist in this phone's GPU device-tree node. */
+		wr(MALI_REG_SHADER_CONFIG, rd(MALI_REG_SHADER_CONFIG) | MALI_G57_SHADER_QUIRK);
+		wr(MALI_REG_JM_CONFIG, rd(MALI_REG_JM_CONFIG) | MALI_G57_IDVS_GROUP_SIZE);
+		wr(MALI_REG_L2_MMU_CONFIG,
+		   rd(MALI_REG_L2_MMU_CONFIG) & ~MALI_G57_MMU_OUTSTANDING_MASK);
+		uint64_t l2 = rd64(MALI_REG_L2_PRESENT_LO), tiler = rd64(MALI_REG_TILER_PRESENT_LO);
+		uint64_t shaders = rd64(MALI_REG_SHADER_PRESENT_LO);
+		if (!l2 || !shaders) {
+			fatal = true;
+			IOLog("SWEET GPU: reset found no L2 or shader cores\n");
+			return false;
+		}
+		wr64(MALI_REG_L2_PWRON_LO, l2);
+		if (!poll(MALI_REG_L2_READY_LO, l2, l2)) {
+			fatal = true;
+			IOLog("SWEET GPU: L2 power-on timed out\n");
+			return false;
+		}
+		wr64(MALI_REG_TILER_PWRON_LO, tiler);
+		wr64(MALI_REG_SHADER_PWRON_LO, shaders);
+		if (!poll(MALI_REG_TILER_READY_LO, tiler, tiler) ||
+		    !poll(MALI_REG_SHADER_READY_LO, shaders, shaders)) {
+			fatal = true;
+			IOLog("SWEET GPU: shader or tiler power-on timed out\n");
+			return false;
+		}
+		ready = true;
+		return true;
+	}
+};
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+struct SweetMaliTable {
+	IOBufferMemoryDescriptor *memory;
+	uint64_t *entries, physical;
+	SweetMaliTable *next;
+};
+struct SweetMaliBO {
+	IOMemoryDescriptor *memory;
+	IOMemoryMap *kernelMap;
+	uint64_t gpuVA, size;
+	uint32_t handle, flags;
+};
+
+static uint64_t sweet_mali_now_ns()
+{
+	uint64_t n = 0;
+	clock_get_uptime(&n);
+	absolutetime_to_nanoseconds(n, &n);
+	return n;
+}
+/* Force actual Cortex-A55 cache maintenance: generic coherent-I/O helpers can
+ * compile to a no-op on an Apple platform configuration. Only pinned RAM is used. */
+static void sweet_mali_cache(uintptr_t address, uint64_t size, bool toGPU)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	uintptr_t end = address + size;
+	for (uintptr_t p = address & ~(uintptr_t)(MALI_GPU_CACHE_LINE_SIZE - 1); p < end;
+	     p += MALI_GPU_CACHE_LINE_SIZE) {
+		if (toGPU) {
+			__asm__ volatile("dc cvac, %0" ::"r"(p) : "memory");
+		} else {
+			__asm__ volatile("dc ivac, %0" ::"r"(p) : "memory");
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static bool sweet_mali_input(IOExternalMethodArguments *a, void *dst, size_t size)
+{
+	if (!a || a->scalarInputCount || a->scalarOutputCount) {
+		return false;
+	}
+	size_t actual = a->structureInputDescriptor ? a->structureInputDescriptor->getLength()
+						    : a->structureInputSize;
+	if (actual != size) {
+		return false;
+	}
+	if (a->structureInputDescriptor) {
+		if (a->structureInputDescriptor->readBytes(0, dst, size) != size) {
+			return false;
+		}
+	} else {
+		if (!a->structureInput) {
+			return false;
+		}
+		memcpy(dst, a->structureInput, size);
+	}
+	MMKHeader *h = (MMKHeader *)dst;
+	return h->version == MMK_ABI_VERSION && h->size == size;
+}
+static bool sweet_mali_output_size(IOExternalMethodArguments *a, size_t size)
+{
+	return a && (a->structureOutputDescriptor ? a->structureOutputDescriptor->getLength()
+						  : a->structureOutputSize) >= size;
+}
+static IOReturn sweet_mali_output(IOExternalMethodArguments *a, void *src, size_t size)
+{
+	if (!sweet_mali_output_size(a, size)) {
+		return kIOReturnNoSpace;
+	}
+	MMKHeader *h = (MMKHeader *)src;
+	h->version = MMK_ABI_VERSION;
+	h->size = (uint32_t)size;
+	if (a->structureOutputDescriptor) {
+		if (a->structureOutputDescriptor->writeBytes(0, src, size) != size) {
+			return kIOReturnVMError;
+		}
+		a->structureOutputDescriptorSize = size;
+	} else {
+		if (!a->structureOutput) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(a->structureOutput, src, size);
+		a->structureOutputSize = size;
+	}
+	return kIOReturnSuccess;
+}
+
+class SweetMaliUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(SweetMaliUserClient);
+	friend class IOAcceleratorES;
+	IOAcceleratorES *gpu;
+	task_t owner;
+	SweetMaliBO bos[MMK_MAX_BOS];
+	SweetMaliTable *tables, *root;
+	uint32_t tableCount, nextHandle, as, jobSlot;
+	uint64_t allocated, sequence, jobDeadline;
+	uint32_t jobHandles[MMK_MAX_SUBMIT_BOS], jobBOCount;
+	MMKWaitResult result;
+	bool closed, quarantined;
+
+	SweetMaliBO *boForHandle(uint32_t handle)
+	{
+		for (unsigned i = 0; i < MMK_MAX_BOS; ++i) {
+			if (bos[i].memory && bos[i].handle == handle) {
+				return &bos[i];
+			}
+		}
+		return NULL;
+	}
+	SweetMaliBO *boForVA(uint64_t va, size_t size)
+	{
+		for (unsigned i = 0; i < MMK_MAX_BOS; ++i) {
+			SweetMaliBO *b = &bos[i];
+			if (b->memory && va >= b->gpuVA && va - b->gpuVA <= b->size &&
+			    size <= b->size - (va - b->gpuVA)) {
+				return b;
+			}
+		}
+		return NULL;
+	}
+	uint64_t freeGPUVA(uint64_t size)
+	{
+		/* Reuse holes so transient compositor BOs do not consume a new set of
+		 * translation pages on every frame. Keep one unmapped guard page. */
+		uint64_t candidate = 0x100000000ull;
+		for (unsigned attempt = 0; attempt <= MMK_MAX_BOS; ++attempt) {
+			bool overlap = false;
+			for (unsigned i = 0; i < MMK_MAX_BOS; ++i) {
+				SweetMaliBO *b = &bos[i];
+				if (!b->memory) {
+					continue;
+				}
+				uint64_t end = b->gpuVA + b->size + MMK_GPU_PAGE_SIZE;
+				if (candidate < end &&
+				    candidate + size + MMK_GPU_PAGE_SIZE > b->gpuVA) {
+					candidate = end;
+					overlap = true;
+					break;
+				}
+			}
+			if (candidate + size + MMK_GPU_PAGE_SIZE >=
+			    (1ull << MALI_GPU_VIRTUAL_BITS)) {
+				return 0;
+			}
+			if (!overlap) {
+				return candidate;
+			}
+		}
+		return 0;
+	}
+	SweetMaliTable *newTable()
+	{
+		if (tableCount >= 1024) {
+			return NULL;
+		}
+		SweetMaliTable *t = (SweetMaliTable *)IOMallocZeroData(sizeof(*t));
+		if (!t) {
+			return NULL;
+		}
+		t->memory = IOBufferMemoryDescriptor::inTaskWithOptions(
+		    kernel_task, kIODirectionInOut | kIOMemoryMapperNone, page_size, page_size);
+		if (!t->memory) {
+			IOFreeData(t, sizeof(*t));
+			return NULL;
+		}
+		t->entries = (uint64_t *)t->memory->getBytesNoCopy();
+		t->physical = t->memory->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+		if (!t->physical || (t->physical & (MMK_GPU_PAGE_SIZE - 1)) ||
+		    (t->physical >> MALI_GPU_PHYSICAL_BITS)) {
+			t->memory->release();
+			IOFreeData(t, sizeof(*t));
+			return NULL;
+		}
+		bzero(t->entries, MMK_GPU_PAGE_SIZE);
+		sweet_mali_cache((uintptr_t)t->entries, MMK_GPU_PAGE_SIZE, true);
+		t->next = tables;
+		tables = t;
+		++tableCount;
+		return t;
+	}
+	uint64_t *pte(uint64_t va, bool create)
+	{
+		if (!root && create) {
+			root = newTable();
+		}
+		SweetMaliTable *t = root;
+		if (!t) {
+			return NULL;
+		}
+		for (unsigned level = 0; level < 3; ++level) {
+			unsigned index = (va >> (39 - level * 9)) & 511;
+			uint64_t entry = t->entries[index];
+			if (!entry) {
+				if (!create) {
+					return NULL;
+				}
+				SweetMaliTable *child = newTable();
+				if (!child) {
+					return NULL;
+				}
+				t->entries[index] = child->physical | MALI_PTE_VALID_AF;
+				sweet_mali_cache((uintptr_t)&t->entries[index], 8, true);
+				t = child;
+			} else {
+				uint64_t pa = entry & MALI_PTE_ADDRESS_MASK;
+				for (t = tables; t && t->physical != pa; t = t->next) {
+				}
+				if (!t) {
+					return NULL;
+				}
+			}
+		}
+		return &t->entries[(va >> 12) & 511];
+	}
+	bool asCommand(uint32_t command)
+	{
+		uint32_t base = MALI_AS_OFFSET(as);
+		for (unsigned i = 0; i < 10000; ++i) {
+			if (!(gpu->rd(base + MALI_AS_STATUS) & 1)) {
+				gpu->wr(base + MALI_AS_COMMAND, command);
+				for (unsigned j = 0; j < 10000; ++j) {
+					if (!(gpu->rd(base + MALI_AS_STATUS) & 1)) {
+						return true;
+					}
+					IODelay(10);
+				}
+				return false;
+			}
+			IODelay(10);
+		}
+		return false;
+	}
+	bool flushAS()
+	{
+		/* Lock the entire 48-bit VA range: size encoding log2(size)-1. */
+		gpu->wr64(MALI_AS_OFFSET(as) + MALI_AS_LOCKADDR_LO, 47);
+		return asCommand(MALI_AS_COMMAND_LOCK) && asCommand(MALI_AS_COMMAND_FLUSH_MEM);
+	}
+	bool bindAS()
+	{
+		if (!root) {
+			return false;
+		}
+		uint32_t base = MALI_AS_OFFSET(as);
+		if (!flushAS()) {
+			return false;
+		}
+		gpu->wr64(base + MALI_AS_TRANSCFG_LO, MALI_G57_AS_TRANSCFG);
+		gpu->wr64(base + MALI_AS_TRANSTAB_LO, root->physical);
+		gpu->wr64(base + MALI_AS_MEMATTR_LO, MALI_G57_AS_MEMATTR);
+		gpu->wr(MALI_MMU_IRQ_CLEAR, (1u << as) | (1u << (as + 16)));
+		return asCommand(MALI_AS_COMMAND_UPDATE);
+	}
+	void clearPages(SweetMaliBO *b)
+	{
+		for (uint64_t o = 0; o < b->size; o += MMK_GPU_PAGE_SIZE) {
+			uint64_t *e = pte(b->gpuVA + o, false);
+			if (e) {
+				*e = 0;
+				sweet_mali_cache((uintptr_t)e, 8, true);
+			}
+		}
+	}
+	void dropBO(SweetMaliBO *b)
+	{
+		allocated -= b->size;
+		if (b->kernelMap) {
+			b->kernelMap->release();
+		}
+		b->memory->complete();
+		b->memory->release();
+		bzero(b, sizeof(*b));
+	}
+	IOReturn syncBO(SweetMaliBO *b, uint64_t offset, uint64_t length, bool toGPU)
+	{
+		if (!length || offset > b->size || length > b->size - offset) {
+			return kIOReturnBadArgument;
+		}
+		/* IVAC cannot discard adjacent dirty CPU bytes on a partial line. */
+		if (!toGPU && ((offset | length) & (MALI_GPU_CACHE_LINE_SIZE - 1))) {
+			return kIOReturnBadArgument;
+		}
+		if (!(b->flags & MMK_BO_CPU_CACHED)) {
+			/* Normal non-cacheable RAM still needs an ownership barrier. */
+			__asm__ volatile("dsb sy" ::: "memory");
+			return kIOReturnSuccess;
+		}
+		sweet_mali_cache((uintptr_t)b->kernelMap->getVirtualAddress() + offset, length,
+				 toGPU);
+		return kIOReturnSuccess;
+	}
+	IOReturn allocate(uint64_t address, uint64_t size, uint32_t flags, bool imported,
+			  MMKBOInfo *out)
+	{
+		const uint64_t limit = 256ull * 1024 * 1024;
+		if (!size || size > limit || allocated > 2 * limit - size || !nextHandle ||
+		    nextHandle >= 0xffffefffu ||
+		    (flags & ~(MMK_BO_READ | MMK_BO_WRITE | MMK_BO_EXEC | MMK_BO_CPU_CACHED)) ||
+		    !(flags & MMK_BO_READ)) {
+			return kIOReturnBadArgument;
+		}
+		if (gpu->active == this) {
+			return kIOReturnBusy;
+		}
+		if (imported && (!address || (address & (page_size - 1)) ||
+				 (size & (page_size - 1)) || address + size < address)) {
+			return kIOReturnBadArgument;
+		}
+		size = (size + page_size - 1) & ~(uint64_t)(page_size - 1);
+		if (allocated > 2 * limit - size) {
+			return kIOReturnNoResources;
+		}
+		uint64_t gpuVA = freeGPUVA(size);
+		if (!gpuVA) {
+			return kIOReturnNoResources;
+		}
+		SweetMaliBO *b = NULL;
+		for (unsigned i = 0; i < MMK_MAX_BOS; ++i) {
+			if (!bos[i].memory) {
+				b = &bos[i];
+				break;
+			}
+		}
+		if (!b) {
+			return kIOReturnNoResources;
+		}
+		/* Imported mappings retain the task's cache mode; never change live aliases. */
+		if (imported && !(flags & MMK_BO_CPU_CACHED)) {
+			return kIOReturnUnsupported;
+		}
+		IOMemoryDescriptor *md =
+		    imported
+			? IOMemoryDescriptor::withAddressRange(
+			      address, size, kIODirectionInOut | kIOMemoryMapperNone, owner)
+			: IOBufferMemoryDescriptor::inTaskWithOptions(
+			      kernel_task,
+			      kIODirectionInOut | kIOMemoryMapperNone | kIOMemoryKernelUserShared |
+				  ((flags & MMK_BO_CPU_CACHED) ? kIOMapCopybackCache
+							       : kIOMapWriteCombineCache),
+			      size, page_size);
+		if (!md) {
+			return kIOReturnNoMemory;
+		}
+		IOReturn ret = md->prepare();
+		if (ret != kIOReturnSuccess) {
+			md->release();
+			return ret;
+		}
+		IOMemoryMap *map = md->map(
+		    kIOMapAnywhere |
+		    ((flags & MMK_BO_CPU_CACHED) ? kIOMapCopybackCache : kIOMapWriteCombineCache));
+		if (!map) {
+			md->complete();
+			md->release();
+			return kIOReturnNoMemory;
+		}
+		b->memory = md;
+		b->kernelMap = map;
+		b->size = size;
+		b->flags = flags;
+		b->gpuVA = gpuVA;
+		if (!imported) {
+			bzero((void *)(uintptr_t)map->getVirtualAddress(), size);
+		}
+		allocated += size;
+		for (uint64_t o = 0; o < size; o += MMK_GPU_PAGE_SIZE) {
+			IOByteCount contiguous = 0;
+			uint64_t pa = md->getPhysicalSegment(o, &contiguous, kIOMemoryMapperNone);
+			uint64_t *e = pte(gpuVA + o, true);
+			if (!pa || (pa & (MMK_GPU_PAGE_SIZE - 1)) ||
+			    (pa >> MALI_GPU_PHYSICAL_BITS) || contiguous < MMK_GPU_PAGE_SIZE ||
+			    !e || *e) {
+				clearPages(b);
+				dropBO(b);
+				return kIOReturnNoMemory;
+			}
+			/* AS mode6 AArch64 page: AF + valid; AP RW/RO; NX unless executable. */
+			*e = pa | MALI_PTE_VALID_AF |
+			     ((flags & MMK_BO_WRITE) ? MALI_PTE_AP_READ_WRITE
+						     : MALI_PTE_AP_READ_ONLY) |
+			     ((flags & MMK_BO_EXEC) ? 0 : MALI_PTE_EXECUTE_NEVER);
+			sweet_mali_cache((uintptr_t)e, 8, true);
+		}
+		/* This address space has no executing job. bindAS() invalidates all
+		 * old translations before its next submission; another client's job
+		 * can continue while these private tables and BOs are changed. */
+		syncBO(b, 0, size, true);
+		b->handle = nextHandle++;
+		bzero(out, sizeof(*out));
+		out->handle = b->handle;
+		out->map_type = MMK_MAP_BO_BASE + b->handle;
+		out->gpu_va = b->gpuVA;
+		out->size = size;
+		out->flags = flags;
+		return kIOReturnSuccess;
+	}
+	void finish(uint32_t state, uint32_t exception)
+	{
+		result.state = state;
+		result.exception = exception;
+		result.completed_ns = sweet_mali_now_ns();
+		uint32_t base = MALI_AS_OFFSET(as);
+		result.fault_status = gpu->rd(base + MALI_AS_FAULTSTATUS);
+		result.fault_address = gpu->rd64(base + MALI_AS_FAULTADDRESS_LO);
+		result.gpu_fault_status = gpu->rd(MALI_REG_GPU_FAULTSTATUS);
+		result.gpu_fault_address = gpu->rd64(MALI_REG_GPU_FAULT_ADDR_LO);
+		if (state == MMK_JOB_COMPLETE) {
+			gpu->wr(MALI_REG_GPU_IRQ_CLEAR, MALI_GPU_IRQ_CLEAN_CACHES_COMPLETED);
+			gpu->wr(MALI_REG_GPU_COMMAND, MALI_GPU_CMD_CLEAN_INV_CACHES);
+			bool clean = false;
+			for (unsigned i = 0; i < 10000; ++i) {
+				if (gpu->rd(MALI_REG_GPU_IRQ_RAWSTAT) &
+				    MALI_GPU_IRQ_CLEAN_CACHES_COMPLETED) {
+					clean = true;
+					break;
+				}
+				IODelay(10);
+			}
+			if (!clean) {
+				result.state = MMK_JOB_TIMEOUT;
+			}
+			gpu->wr(MALI_REG_GPU_IRQ_CLEAR, MALI_GPU_IRQ_CLEAN_CACHES_COMPLETED);
+		}
+		if (result.state != MMK_JOB_COMPLETE && !gpu->reset()) {
+			/* DMA may still be active: preserve the wiring and translation pages. */
+			if (!quarantined) {
+				quarantined = true;
+				retain();
+			}
+		}
+		if (!quarantined) {
+			for (unsigned i = 0; i < jobBOCount; ++i) {
+				SweetMaliBO *b = boForHandle(jobHandles[i]);
+				if (b && (b->flags & MMK_BO_WRITE)) {
+					syncBO(b, 0, b->size, false);
+				}
+			}
+			jobBOCount = 0;
+			gpu->active = NULL;
+		}
+	}
+	void pollJob()
+	{
+		if (gpu->active != this || result.state != MMK_JOB_PENDING) {
+			return;
+		}
+		uint32_t done = 1u << jobSlot, failed = 1u << (jobSlot + 16);
+		uint32_t irq = gpu->rd(MALI_JOB_IRQ_RAWSTAT);
+		uint32_t mmu = gpu->rd(MALI_MMU_IRQ_RAWSTAT);
+		uint32_t fault = gpu->rd(MALI_REG_GPU_IRQ_RAWSTAT) & 0x81;
+		if ((irq & failed) || (mmu & ((1u << as) | (1u << (as + 16)))) || fault) {
+			uint32_t status = gpu->rd(MALI_JS_OFFSET(jobSlot) + MALI_JS_STATUS);
+			gpu->wr(MALI_JOB_IRQ_CLEAR, done | failed);
+			finish(MMK_JOB_FAULT, status);
+		} else if (irq & done) {
+			uint32_t status = gpu->rd(MALI_JS_OFFSET(jobSlot) + MALI_JS_STATUS);
+			gpu->wr(MALI_JOB_IRQ_CLEAR, done | failed);
+			finish(MMK_JOB_COMPLETE, status);
+		} else if (sweet_mali_now_ns() >= jobDeadline) {
+			finish(MMK_JOB_TIMEOUT, gpu->rd(MALI_JS_OFFSET(jobSlot) + MALI_JS_STATUS));
+		}
+	}
+	void cleanup()
+	{
+		if (!gpu || closed) {
+			return;
+		}
+		IOLockLock(gpu->gpuLock);
+		if (closed) {
+			IOLockUnlock(gpu->gpuLock);
+			return;
+		}
+		if (gpu->active == this && result.state == MMK_JOB_PENDING) {
+			finish(MMK_JOB_CANCELLED, 0);
+		}
+		if (!quarantined) {
+			if (as < 16 && gpu->ready) {
+				if (!flushAS()) {
+					/* A device-wide reset must retire another connection's
+					 * fence too, rather than leaving it apparently pending. */
+					if (gpu->active) {
+						gpu->active->finish(MMK_JOB_CANCELLED, 0);
+					} else {
+						gpu->reset();
+					}
+					if (gpu->fatal) {
+						quarantined = true;
+						retain();
+					}
+				}
+				if (!quarantined) {
+					gpu->wr64(MALI_AS_OFFSET(as) + MALI_AS_TRANSCFG_LO, 1);
+					asCommand(MALI_AS_COMMAND_UPDATE);
+				}
+			}
+			if (!quarantined) {
+				for (unsigned i = 0; i < MMK_MAX_BOS; ++i) {
+					if (bos[i].memory) {
+						clearPages(&bos[i]);
+						dropBO(&bos[i]);
+					}
+				}
+				while (tables) {
+					SweetMaliTable *t = tables;
+					tables = t->next;
+					t->memory->release();
+					IOFreeData(t, sizeof(*t));
+				}
+				root = NULL;
+				if (as < 16) {
+					gpu->asUsed &= ~(1u << as);
+				}
+			}
+		}
+		closed = true;
+		IOLockUnlock(gpu->gpuLock);
+	}
+
+public:
+	bool initWithTask(task_t task, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE
+	{
+		if (type != 0 || !IOUserClient::initWithTask(task, securityID, type)) {
+			return false;
+		}
+		owner = task;
+		task_reference(owner);
+		gpu = NULL;
+		tables = root = NULL;
+		tableCount = 0;
+		nextHandle = 1;
+		as = ~0u;
+		allocated = sequence = 0;
+		closed = quarantined = false;
+		jobBOCount = 0;
+		bzero(bos, sizeof(bos));
+		bzero(&result, sizeof(result));
+		return true;
+	}
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE
+	{
+		if (!IOUserClient::start(provider)) {
+			return false;
+		}
+		gpu = OSDynamicCast(IOAcceleratorES, provider);
+		if (!gpu) {
+			return false;
+		}
+		IOLockLock(gpu->gpuLock);
+		if (!gpu->regs) {
+			gpu->regs = (volatile uint32_t *)ml_io_map(0x13000000, 0x4000);
+		}
+		if (gpu->regs) {
+			uint32_t available = gpu->rd(MALI_REG_AS_PRESENT) & 0xffffu & ~gpu->asUsed;
+			for (as = 0; as < 16; ++as) {
+				if (available & (1u << as)) {
+					gpu->asUsed |= 1u << as;
+					break;
+				}
+			}
+		}
+		IOLockUnlock(gpu->gpuLock);
+		return gpu->regs && as < 16;
+	}
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE
+	{
+		cleanup();
+		IOUserClient::stop(provider);
+	}
+	void free() APPLE_KEXT_OVERRIDE
+	{
+		cleanup();
+		if (owner) {
+			task_deallocate(owner);
+			owner = NULL;
+		}
+		IOUserClient::free();
+	}
+	IOReturn clientClose() APPLE_KEXT_OVERRIDE
+	{
+		cleanup();
+		terminate();
+		return quarantined ? kIOReturnIOError : kIOReturnSuccess;
+	}
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+				     IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE
+	{
+		if (!memory || !options || !gpu) {
+			return kIOReturnBadArgument;
+		}
+		*memory = NULL;
+		IOLockLock(gpu->gpuLock);
+		SweetMaliBO *b =
+		    type > MMK_MAP_BO_BASE ? boForHandle(type - MMK_MAP_BO_BASE) : NULL;
+		IOReturn ret = kIOReturnBadArgument;
+		if (!closed && b) {
+			b->memory->retain();
+			*memory = b->memory;
+			*options = (b->flags & MMK_BO_CPU_CACHED) ? kIOMapCopybackCache
+								  : kIOMapWriteCombineCache;
+			ret = kIOReturnSuccess;
+		}
+		IOLockUnlock(gpu->gpuLock);
+		return ret;
+	}
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+				IOExternalMethodDispatch *, OSObject *, void *) APPLE_KEXT_OVERRIDE
+	{
+		if (!gpu || closed || !args) {
+			return kIOReturnNotOpen;
+		}
+		IOLockLock(gpu->gpuLock);
+		if (closed) {
+			IOLockUnlock(gpu->gpuLock);
+			return kIOReturnNotOpen;
+		}
+		if (gpu->active) {
+			gpu->active->pollJob();
+		}
+		IOReturn ret = dispatch(selector, args);
+		IOLockUnlock(gpu->gpuLock);
+		return ret;
+	}
+	IOReturn dispatch(uint32_t selector, IOExternalMethodArguments *a)
+	{
+		if (selector == MMK_QUERY) {
+			MMKHeader req;
+			if (!sweet_mali_input(a, &req, sizeof(req))) {
+				return kIOReturnBadArgument;
+			}
+			MMKQuery q = {};
+			q.gpu_id = gpu->rd(MALI_REG_GPU_ID);
+			q.l2_features = gpu->rd(MALI_REG_L2_FEATURES);
+			q.core_features = gpu->rd(MALI_REG_CORE_FEATURES);
+			q.tiler_features = gpu->rd(MALI_REG_TILER_FEATURES);
+			q.mem_features = gpu->rd(MALI_REG_MEM_FEATURES);
+			q.mmu_features = gpu->rd(MALI_REG_MMU_FEATURES);
+			q.as_present = gpu->rd(MALI_REG_AS_PRESENT);
+			q.js_present = gpu->rd(MALI_REG_JS_PRESENT);
+			q.shader_present = gpu->rd64(MALI_REG_SHADER_PRESENT_LO);
+			q.tiler_present = gpu->rd64(MALI_REG_TILER_PRESENT_LO);
+			q.l2_present = gpu->rd64(MALI_REG_L2_PRESENT_LO);
+			q.gpu_page_size = MMK_GPU_PAGE_SIZE;
+			q.max_bo_size = 256ull * 1024 * 1024;
+			q.max_bos = MMK_MAX_BOS;
+			q.max_submit_bos = MMK_MAX_SUBMIT_BOS;
+			q.capabilities =
+			    MMK_CAP_BO_ALLOC | MMK_CAP_BO_IMPORT | MMK_CAP_EXPLICIT_SYNC;
+			if (q.gpu_id == MALI_G57_R0P1_GPU_ID && gpu->railsVerified && !gpu->fatal) {
+				q.capabilities |= MMK_CAP_JM_SUBMIT;
+			}
+			for (unsigned i = 0; i < 3; ++i) {
+				q.js_features[i] = gpu->rd(0xc0 + 4 * i);
+			}
+			q.cpu_page_size = page_size;
+			for (unsigned i = 0; i < 4; ++i) {
+				q.texture_features[i] = gpu->rd(0xb0 + 4 * i);
+			}
+			q.thread_max_threads = gpu->rd(0xa0);
+			q.thread_max_workgroup_size = gpu->rd(0xa4);
+			q.thread_max_barrier_size = gpu->rd(0xa8);
+			q.thread_features = gpu->rd(0xac);
+			q.thread_tls_alloc = gpu->rd(0x310);
+			q.afbc_features = gpu->rd(0x4c);
+			return sweet_mali_output(a, &q, sizeof(q));
+		}
+		if (gpu->fatal) {
+			return kIOReturnNotReady;
+		}
+		if (selector == MMK_BO_ALLOC || selector == MMK_BO_IMPORT) {
+			if (!sweet_mali_output_size(a, sizeof(MMKBOInfo))) {
+				return kIOReturnNoSpace;
+			}
+			MMKBOInfo out;
+			IOReturn ret;
+			if (selector == MMK_BO_ALLOC) {
+				MMKBOAlloc req;
+				if (!sweet_mali_input(a, &req, sizeof(req)) || req.reserved) {
+					return kIOReturnBadArgument;
+				}
+				ret = allocate(0, req.size, req.flags, false, &out);
+			} else {
+				MMKBOImport req;
+				if (!sweet_mali_input(a, &req, sizeof(req)) || req.reserved) {
+					return kIOReturnBadArgument;
+				}
+				ret = allocate(req.address, req.size, req.flags, true, &out);
+			}
+			return ret == kIOReturnSuccess ? sweet_mali_output(a, &out, sizeof(out))
+						       : ret;
+		}
+		if (selector == MMK_BO_RELEASE) {
+			MMKBORelease req;
+			if (!sweet_mali_input(a, &req, sizeof(req)) || req.reserved) {
+				return kIOReturnBadArgument;
+			}
+			if (gpu->active == this) {
+				return kIOReturnBusy;
+			}
+			SweetMaliBO *b = boForHandle(req.handle);
+			if (!b) {
+				return kIOReturnBadArgument;
+			}
+			clearPages(b);
+			/* A future job must bindAS() and flush before using this VA. */
+			dropBO(b);
+			return kIOReturnSuccess;
+		}
+		if (selector == MMK_BO_SYNC) {
+			MMKBOSync req;
+			if (!sweet_mali_input(a, &req, sizeof(req)) ||
+			    (req.direction != MMK_SYNC_CPU_TO_GPU &&
+			     req.direction != MMK_SYNC_GPU_TO_CPU)) {
+				return kIOReturnBadArgument;
+			}
+			if (gpu->active == this) {
+				return kIOReturnBusy;
+			}
+			SweetMaliBO *b = boForHandle(req.handle);
+			return b ? syncBO(b, req.offset, req.length,
+					  req.direction == MMK_SYNC_CPU_TO_GPU)
+				 : kIOReturnBadArgument;
+		}
+		if (selector == MMK_SUBMIT) {
+			MMKSubmit req;
+			if (!sweet_mali_input(a, &req, sizeof(req)) ||
+			    !sweet_mali_output_size(a, sizeof(MMKSubmitResult)) || !req.bo_count ||
+			    req.bo_count > MMK_MAX_SUBMIT_BOS || req.slot > 2 ||
+			    (req.job_chain & 127)) {
+				return kIOReturnBadArgument;
+			}
+			if (gpu->active) {
+				return kIOReturnBusy;
+			}
+			if (gpu->rd(MALI_REG_GPU_ID) != MALI_G57_R0P1_GPU_ID ||
+			    !(gpu->rd(MALI_REG_JS_PRESENT) & (1u << req.slot))) {
+				return kIOReturnUnsupported;
+			}
+			if (!gpu->railsVerified) {
+				return kIOReturnNotReady;
+			}
+			if (req.dependency &&
+			    (req.dependency != sequence || result.state != MMK_JOB_COMPLETE)) {
+				return kIOReturnNotReady;
+			}
+			SweetMaliBO *chain = boForVA(req.job_chain, 32);
+			if (!chain || !(chain->flags & MMK_BO_WRITE)) {
+				return kIOReturnBadArgument;
+			}
+			bool included = false;
+			for (unsigned i = 0; i < req.bo_count; ++i) {
+				SweetMaliBO *b = boForHandle(req.handles[i]);
+				if (!b) {
+					return kIOReturnBadArgument;
+				}
+				if (b == chain) {
+					included = true;
+				}
+			}
+			if (!included) {
+				return kIOReturnBadArgument;
+			}
+			if (!gpu->ready && !gpu->reset()) {
+				return kIOReturnNotReady;
+			}
+			if (!bindAS()) {
+				gpu->reset();
+				return kIOReturnTimeout;
+			}
+			for (unsigned i = 0; i < req.bo_count; ++i) {
+				SweetMaliBO *b = boForHandle(req.handles[i]);
+				syncBO(b, 0, b->size, true);
+			}
+			memcpy(jobHandles, req.handles, req.bo_count * sizeof(req.handles[0]));
+			jobBOCount = req.bo_count;
+			jobSlot = req.slot;
+			uint32_t base = MALI_JS_OFFSET(jobSlot);
+			if (gpu->rd(base + MALI_JS_COMMAND_NEXT) ||
+			    gpu->rd(base + MALI_JS_COMMAND)) {
+				return kIOReturnBusy;
+			}
+			bzero(&result, sizeof(result));
+			result.hdr.version = MMK_ABI_VERSION;
+			result.hdr.size = sizeof(result);
+			result.sequence = ++sequence;
+			result.state = MMK_JOB_PENDING;
+			gpu->wr(MALI_JOB_IRQ_CLEAR, (1u << jobSlot) | (1u << (jobSlot + 16)));
+			gpu->wr64(base + MALI_JS_HEAD_NEXT_LO, req.job_chain);
+			gpu->wr64(base + MALI_JS_AFFINITY_NEXT_LO,
+				  gpu->rd64(MALI_REG_SHADER_READY_LO));
+			/* AS[3:0], CLEAN_INVALIDATE start/end[9:8]/[13:12], PRIORITY8. */
+			gpu->wr(base + MALI_JS_CONFIG_NEXT,
+				as | MALI_JS_CONFIG_CACHE_FLUSH | MALI_JS_CONFIG_PRIORITY);
+			gpu->wr(base + MALI_JS_FLUSH_ID_NEXT, 0);
+			gpu->active = this;
+			jobDeadline = sweet_mali_now_ns() + MMK_MAX_WAIT_NS;
+			gpu->wr(base + MALI_JS_COMMAND_NEXT, MALI_JS_COMMAND_START);
+			gpu->gpuTimer->setTimeoutMS(1);
+			MMKSubmitResult out = {{MMK_ABI_VERSION, sizeof(out)}, sequence};
+			return sweet_mali_output(a, &out, sizeof(out));
+		}
+		if (selector == MMK_WAIT) {
+			MMKWait req;
+			if (!sweet_mali_input(a, &req, sizeof(req)) ||
+			    !sweet_mali_output_size(a, sizeof(MMKWaitResult)) || !req.sequence ||
+			    req.sequence != sequence || req.timeout_ns > MMK_MAX_WAIT_NS) {
+				return kIOReturnBadArgument;
+			}
+			uint64_t until = sweet_mali_now_ns() + req.timeout_ns;
+			do {
+				pollJob();
+				if (result.state != MMK_JOB_PENDING ||
+				    sweet_mali_now_ns() >= until) {
+					break;
+				}
+				/* Release mutex while sleeping so close/cancellation can run. */
+				IOLockUnlock(gpu->gpuLock);
+				IOSleep(1);
+				IOLockLock(gpu->gpuLock);
+				if (closed) {
+					return kIOReturnAborted;
+				}
+				if (req.sequence != sequence) {
+					return kIOReturnNotFound;
+				}
+			} while (true);
+			return sweet_mali_output(a, &result, sizeof(result));
+		}
+		return kIOReturnUnsupported;
+	}
+};
+OSDefineMetaClassAndStructors(SweetMaliUserClient, IOUserClient);
+
+void IOAcceleratorES::timerFired(OSObject *owner, IOTimerEventSource *timer)
+{
+	IOAcceleratorES *gpu = OSDynamicCast(IOAcceleratorES, owner);
+	if (!gpu) {
+		return;
+	}
+	IOLockLock(gpu->gpuLock);
+	if (gpu->active) {
+		gpu->active->pollJob();
+		if (gpu->active && !gpu->fatal) {
+			timer->setTimeoutMS(1);
+		}
+	}
+	IOLockUnlock(gpu->gpuLock);
+}
