From 582e0830ff52dfcdd0e4b1fb54622f2da64b72f4 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 20:14:26 +0500
Subject: [PATCH] x676c: eliminate console scroll lag using cached DRAM shadow
 framebuffer

---
 pexpert/arm/pe_serial.c | 49 +++++++++++++++++++++++++++++++++--------
 1 file changed, 40 insertions(+), 9 deletions(-)

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 56cf401..80f6a6b 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -716,10 +716,12 @@ extern unsigned char iso_font[256 * 16];
 #define FBCON_SCALE     2
 #define FBCON_FG        0xffffffffu
 #define FBCON_BG        0xff000000u
+#define FBCON_MAX_PIXELS (1080 * 2400)
 
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+static uint32_t fbcon_shadow[FBCON_MAX_PIXELS] __attribute__((aligned(64)));
 
 static void
 fbcon_clear_row(uint32_t row)
@@ -728,11 +730,14 @@ fbcon_clear_row(uint32_t row)
 	uint32_t width_u64 = fbcon_width / 2;
 	uint64_t bg64 = ((uint64_t)FBCON_BG << 32) | FBCON_BG;
 	volatile uint64_t *base64 = (volatile uint64_t *)fbcon_base;
+	uint64_t *shadow64 = (uint64_t *)fbcon_shadow;
 
-	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
-		volatile uint64_t *line = base64 + y * stride_u64;
+	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE && y < fbcon_height; y++) {
+		volatile uint64_t *line_vram = base64 + y * stride_u64;
+		uint64_t *line_shadow = shadow64 + y * width_u64;
 		for (uint32_t x = 0; x < width_u64; x++) {
-			line[x] = bg64;
+			line_shadow[x] = bg64;
+			line_vram[x] = bg64;
 		}
 	}
 }
@@ -744,17 +749,37 @@ fbcon_scroll(void)
 	uint32_t top = (fbcon_rows - 1) * cell_h;
 	uint32_t stride_u64 = fbcon_stride / 8;
 	uint32_t width_u64 = fbcon_width / 2;
+	uint64_t bg64 = ((uint64_t)FBCON_BG << 32) | FBCON_BG;
 	volatile uint64_t *base64 = (volatile uint64_t *)fbcon_base;
+	uint64_t *shadow64 = (uint64_t *)fbcon_shadow;
 
+	/* 1. Fast scroll inside cached DRAM shadow buffer (L1/L2 hits) */
 	for (uint32_t y = 0; y < top; y++) {
-		volatile uint64_t *dst = base64 + y * stride_u64;
-		volatile uint64_t *src = base64 + (y + cell_h) * stride_u64;
+		uint64_t *dst = shadow64 + y * width_u64;
+		const uint64_t *src = shadow64 + (y + cell_h) * width_u64;
 		for (uint32_t x = 0; x < width_u64; x++) {
 			dst[x] = src[x];
 		}
 	}
+
+	/* 2. Clear bottom row in shadow buffer */
+	for (uint32_t y = top; y < top + cell_h && y < fbcon_height; y++) {
+		uint64_t *dst = shadow64 + y * width_u64;
+		for (uint32_t x = 0; x < width_u64; x++) {
+			dst[x] = bg64;
+		}
+	}
+
+	/* 3. Stream shadow buffer to physical VRAM (Zero uncached reads!) */
+	for (uint32_t y = 0; y < top + cell_h && y < fbcon_height; y++) {
+		volatile uint64_t *dst_vram = base64 + y * stride_u64;
+		const uint64_t *src_shadow = shadow64 + y * width_u64;
+		for (uint32_t x = 0; x < width_u64; x++) {
+			dst_vram[x] = src_shadow[x];
+		}
+	}
+
 	fbcon_row = fbcon_rows - 1;
-	fbcon_clear_row(fbcon_row);
 }
 
 static void
@@ -802,13 +827,18 @@ fbcon_transmit_data(uint8_t c)
 	}
 	const unsigned char *glyph = iso_font + c * 16;
 	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+	uint32_t stride_px = fbcon_stride / 4;
 	for (uint32_t gy = 0; gy < 16; gy++) {
 		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
-			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			uint32_t y = y0 + gy * FBCON_SCALE + sy;
+			volatile uint32_t *vram_line = fbcon_base + y * stride_px + x0;
+			uint32_t *shadow_line = fbcon_shadow + y * fbcon_width + x0;
 			for (uint32_t gx = 0; gx < 8; gx++) {
 				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
 				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
-					line[gx * FBCON_SCALE + sx] = px;
+					uint32_t off = gx * FBCON_SCALE + sx;
+					shadow_line[off] = px;
+					vram_line[off] = px;
 				}
 			}
 		}
@@ -859,7 +889,8 @@ fbcon_probe(void)
 	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
 		fbcon_stride = *val;
 	}
-	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4 ||
+	    (uint64_t)fbcon_width * fbcon_height > FBCON_MAX_PIXELS) {
 		return;
 	}
 	sweet_early_mark(17, "fbcon config read; mapping");
-- 
2.51.0.windows.1

