+		uint64_t cont_unslid = cont ? (cont - (uint64_t)vm_kernel_slide) : 0;
+		printf("SMP %s t%d kern [state=0x%x cont=0x%llx (unslid 0x%llx) wait_event=0x%llx wr=%d rsn=0x%x]\n",
