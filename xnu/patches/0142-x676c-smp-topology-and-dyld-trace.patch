diff --git a/bsd/dev/ufs/ufshci.c b/bsd/dev/ufs/ufshci.c
index 4092467..783ce6e 100644
--- a/bsd/dev/ufs/ufshci.c
+++ b/bsd/dev/ufs/ufshci.c
@@ -401,6 +401,29 @@ ufs_scsi(struct ufs_hba *hba, struct ufs_xfer *x)
 
 	x->scsi_status = 0xff;
 	x->sense_key = x->asc = x->ascq = 0;
+	/*
+	 * Heartbeat (boot-arg ufsbeat=N, default 4096): every N data commands,
+	 * print a line. During the dyld shared-cache mapping this says whether
+	 * the driver is still serving page-fault reads (slow) or wedged (hung).
+	 */
+	static volatile uint64_t ufs_cmds;      /* a dropped count now and then is fine */
+	static uint32_t ufs_beat = 4096;
+	static int ufs_beat_parsed;
+	if (!ufs_beat_parsed) {
+		(void)PE_parse_boot_argn("ufsbeat", &ufs_beat, sizeof(ufs_beat));
+		ufs_beat_parsed = 1;
+	}
+	if (x->len) {
+		uint64_t n = ++ufs_cmds;
+		if (ufs_beat && (n % ufs_beat) == 0) {
+			printf("ufshci: %llu data commands, last op 0x%02x lba %llu\n",
+			    n, x->cdb[0], x->cdb_len >= 10 ?
+			    ((uint64_t)x->cdb[2] << 56 | (uint64_t)x->cdb[3] << 48 |
+			     (uint64_t)x->cdb[4] << 40 | (uint64_t)x->cdb[5] << 32 |
+			     (uint64_t)x->cdb[6] << 24 | (uint64_t)x->cdb[7] << 16 |
+			     (uint64_t)x->cdb[8] << 8 | x->cdb[9]) : 0);
+		}
+	}
 	int error = ufs_exec(hba, req, sizeof(req), x->dir, x->segs, x->nsegs, resp, sizeof(resp));
 	if (error) {
 		return error;
