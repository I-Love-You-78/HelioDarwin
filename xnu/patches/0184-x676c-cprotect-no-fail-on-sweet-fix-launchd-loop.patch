From eb8ecd8eca1d7e8cec1b422094524d24229cee0d Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Fri, 23 Oct 2026 08:09:19 +0500
Subject: [PATCH] x676c: never fail cprotect open/setclass on SWEET (fix
 launchd.log EINVAL loop)

SWEET has no AKS/keybag, so cprotect key-wrap for a non-F protection class
cannot succeed. open_dprotected_np() of an existing launchd.log therefore
returned EINVAL(22) from cp_vnode_setclass (the non-F wrap path), and launchd
spun forever retrying fopen() at 100% CPU -- flooding the ramoops ring and
blocking userland from progressing. 0179 only covered the class-F path.

Treat cprotect open and setclass as non-fatal on SWEET: log the first failure
(one-shot, so it does not flood the ring) and force success. The whole SWEET
port already bypasses code-signing/AMFI/cprotect; with no key hardware this is
the correct bring-up behaviour.
---
 bsd/sweet_hfs/core/hfs_cprotect.c | 40 +++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/bsd/sweet_hfs/core/hfs_cprotect.c b/bsd/sweet_hfs/core/hfs_cprotect.c
index 46a6f03..faaf824 100644
--- a/bsd/sweet_hfs/core/hfs_cprotect.c
+++ b/bsd/sweet_hfs/core/hfs_cprotect.c
@@ -767,6 +767,29 @@ cp_vnode_setclass(struct vnode *vp, cp_key_class_t newclass)
 	}
 
 out:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SWEET has no AKS/keybag, so cprotect key-wrap for a non-F class cannot
+	 * succeed. That made open_dprotected_np() of an existing log file (e.g.
+	 * launchd.log) fail with EINVAL, and launchd then spun forever retrying
+	 * fopen(). 0179 only covered class F. Log the first failure, then treat
+	 * setclass as a no-op success: the file keeps its existing cprotect entry
+	 * and opens normally.
+	 */
+	if (error != 0) {
+		static int sweet_setclass_logged = 0;
+		if (!sweet_setclass_logged) {
+			sweet_setclass_logged = 1;
+			const char *nm = vnode_getname(vp);
+			printf("SWEET CP: setclass '%s' newclass=%d reg=%d -> err=%d (forcing ok)\n",
+			    nm ? nm : "?", newclass, vnode_isreg(vp) ? 1 : 0, error);
+			if (nm) {
+				vnode_putname(nm);
+			}
+		}
+		error = 0;
+	}
+#endif
 
 	if (took_truncate_lock) {
 		hfs_unlock_truncate (cp, HFS_LOCK_DEFAULT);
@@ -1229,6 +1252,23 @@ cp_handle_open(struct vnode *vp, int mode)
 	}
 
 out:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* No AKS on SWEET: never fail open() on a content-protected file (the whole
+	 * SWEET port already bypasses cprotect/AMFI). Log the first failure. */
+	if (error != 0) {
+		static int sweet_open_logged = 0;
+		if (!sweet_open_logged) {
+			sweet_open_logged = 1;
+			const char *nm = vnode_getname(vp);
+			printf("SWEET CP: handle_open '%s' class=%d -> err=%d (forcing ok)\n",
+			    nm ? nm : "?", entry ? (int)CP_CLASS(entry->cp_pclass) : -1, error);
+			if (nm) {
+				vnode_putname(nm);
+			}
+		}
+		error = 0;
+	}
+#endif
 
 #if HFS_TMPDBG
 #if !SECURE_KERNEL
-- 
