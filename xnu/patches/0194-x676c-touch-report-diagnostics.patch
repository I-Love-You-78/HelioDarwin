+		printf("SWEET TOUCH: frame=%u status=%#x dma=%#llx "
+		    "raw=%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    st.s_frames, st.irq_status, (unsigned long long)mt.physical,
+		    report[0], report[1], report[2], report[3], report[4], report[5],
+		    report[6], report[7], report[8], report[9], report[10], report[11]);
+	}
 	if ((format != 0 && format != 2) || count > MTK_TOUCH_CONTACTS) {
 		return EIO; /* includes all-FF reset/recovery frames */
 	}
