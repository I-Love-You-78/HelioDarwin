From eda8f35fcbc1342a6f8e2efaa3333923e5ef4d0b Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Fri, 23 Oct 2026 01:41:10 +0500
Subject: [PATCH] x676c: remove auto-swipe, publish MaliMetal accelerator
 properties before registerService

---
 bsd/dev/sweet_keys.c                  | 39 +--------------------------
 iokit/Kernel/arm/SweetFramebuffer.cpp |  7 +++--
 2 files changed, 6 insertions(+), 40 deletions(-)

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 091630b..61d214d 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -15,7 +15,6 @@
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
-extern void sweet_hid_touch(int finger, int down, int x, int y);
 void sweet_keys_init(void);
 
 /* MediaTek MT6789 Keypad (Infinix Note 12 2023 / X676C) */
@@ -102,46 +101,16 @@ keys_wait(void)
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
-static void
-sweet_simulate_unlock_swipe(void)
-{
-	printf("SWEET KEYS: performing unlock swipe-up gesture\n");
-	/* Finger 0 down at bottom edge center (540, 2380) with edge tip flag */
-	sweet_hid_touch(0, 1, 540, 2380);
-	delay(16000);
-
-	/* Smooth swipe up from 2380 to 900 */
-	for (int y = 2300; y >= 900; y -= 100) {
-		sweet_hid_touch(0, 1, 540, y);
-		delay(16000);
-	}
-
-	/* Finger 0 up at 900 */
-	sweet_hid_touch(0, 0, 540, 900);
-	printf("SWEET KEYS: unlock swipe-up gesture completed\n");
-}
-
 static void
 keys_thread_mtk(void *arg, wait_result_t result)
 {
 	int state[3] = {0, 0, 0}; /* 0: Power, 1: Vol Up, 2: Vol Down */
-	unsigned count = 0;
-	bool unlocked = false;
-	int autounlock = 1;
 	(void)arg;
 	(void)result;
 
-	(void)PE_parse_boot_argn("sweetunlock", &autounlock, sizeof(autounlock));
-	printf("SWEET KEYS: MTK Keypad polling started (autounlock=%d)\n", autounlock);
+	printf("SWEET KEYS: MTK Keypad polling started (pure hardware input)\n");
 
 	for (;;) {
-		count++;
-		/* Auto-unlock after ~6 seconds (300 ticks * 20ms = 6s) */
-		if (autounlock && !unlocked && count == 300) {
-			unlocked = true;
-			sweet_simulate_unlock_swipe();
-		}
-
 		uint32_t mem1 = *(volatile uint32_t *)(keys_mtk_base + MTK_KPD_MEM1);
 		__asm__ volatile("dmb oshld" ::: "memory");
 
@@ -165,12 +134,6 @@ keys_thread_mtk(void *arg, wait_result_t result)
 				    k, k == 0 ? "Power" : (k == 1 ? "Vol+" : "Vol-"),
 				    state[k], mem1);
 				sweet_hid_key(k, state[k]);
-
-				/* On first user key press, if screen was still locked, swipe up */
-				if (!unlocked && state[k]) {
-					unlocked = true;
-					sweet_simulate_unlock_swipe();
-				}
 			}
 		}
 
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index f221932..f07e52a 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -437,8 +437,10 @@ AppleCLCD::start(IOService *provider)
 	if (accel != NULL && accel->init()) {
 		accel->setName("sgx");
 		if (accel->attach(this)) {
-			accel->registerService();
-			IOLog("SWEET FB: empty IOAcceleratorES published (no 30 s wait in CAMetalContextCreate)\n");
+			if (!sweet_board_x676c()) {
+				accel->registerService();
+				IOLog("SWEET FB: empty IOAcceleratorES published (no 30 s wait in CAMetalContextCreate)\n");
+			}
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 			if (sweet_board_x676c()) {
 				IOLog("SWEET GPU: powering on MT6789 Mali-G57 subsystem...\n");
@@ -540,6 +542,7 @@ AppleCLCD::start(IOService *provider)
 					accel->setProperty("device-id", dev_id, 32);
 					accel->setProperty("gpu-core-count", 2ULL, 32);
 					accel->setProperty(kIOUserClientClassKey, "SweetMaliUserClient");
+					accel->registerService();
 					IOLog("SWEET GPU: Mali-G57 registered as MaliMetal / MaliMetalDevice (vendor 0x13b5, device 0x%04llx)\n",
 					    dev_id & 0xffff);
 				}
-- 
2.51.0.windows.1

