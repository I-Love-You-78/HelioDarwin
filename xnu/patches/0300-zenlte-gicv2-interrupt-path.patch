From: S6 Edge+ bring-up (zenlte / Exynos 7420)
Subject: [zenlte] Exynos 7420 bring-up: GIC-400 (GICv2) interrupt path

Generated against the tree this build chain actually produces (xnu-8796.121.2
plus the darwin-xnu-build fixes plus every earlier patch in this directory),
not against pristine Apple source. That matters: 0004 rewrites pe_fiq.c and
sleh.c, so a patch against the original files cannot apply here.

Every existing phone target in this tree is a GICv3 part. Exynos 7420 -
Galaxy S6, S6 Edge, S6 Edge+ (SM-G928), Note 5 - has a GIC-400: one
memory-mapped CPU interface frame banked per core, no redistributors, SGI
delivery through GICD_SGIR. This patch adds a ZENLTE machine configuration
with its own interrupt path and leaves the GICv3 code untouched.

Hardware values from samsungexynos7420/android_kernel_samsung_universal7420,
arch/arm64/boot/dts/exynos7420.dtsi (lineage-19.1):

  gic: interrupt-controller@11001000
    reg = <0x11001000 0x1000>   distributor
          <0x11002000 0x1000>   CPU interface
  timer: interrupts = <1 13 0xff01>, <1 14 0xff01>, <1 11 0xff01>, <1 10 0xff01>

What changes:
  makedefs/MakeInc.def          registers ZENLTE, -march=armv8-a (ARMv8.0, no
                                crypto extension, no PAN)
  pexpert/pexpert/arm64/zenlte.h  new: GIC-400 frames, register offsets,
                                timer INTID 14, accessors
  pexpert/arm/pe_fiq.c          ZENLTE returns after its own GIC-400 init
                                instead of running the GICv3 sequence
  osfmk/arm64/sleh.c            ZENLTE acknowledges through GICC_IAR and ends
                                through GICC_EOIR

ZENLTE borrows the sweet IRQ counters and profiler so the boot log can show
whether the timer is firing; that is the first hardware gate.

Verified: applies cleanly on the full patch chain and on the tree CI builds.
Not yet verified: a successful ZENLTE kernel link, and anything on hardware.

diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 7a7cf4d..fbf70b7 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET ZENLTE
 
 endif
 
@@ -64,6 +64,7 @@ MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 # topaz: Cortex-A53/A73 are ARMv8.0 (no LSE atomics, RCpc, PAN or FP16). An explicit
 # -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default and its LSE/RCpc features
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53
+MACHINE_FLAGS_ARM64_ZENLTE = -DARM64_BOARD_CONFIG_ZENLTE              -march=armv8-a
 
 
 #
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 5e4b82e..f7fa6e5 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -257,7 +257,7 @@ void cpu_signal_handler(void);
 extern unsigned int gFastIPI;
 #endif /* defined(HAS_IPI) */
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(ZENLTE)
 /* Bring-up: count IRQs taken so the sampler can tell whether the vtimer
  * (and thus scheduler wakeups) is actually firing. */
 volatile uint64_t sweet_irq_total, sweet_irq_timer, sweet_irq_ipi, sweet_irq_other;
@@ -2032,7 +2032,49 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
-#if defined(SWEET)
+#if defined(ZENLTE)
+	/*
+	 * GIC-400 (Exynos 7420): the CPU interface is memory mapped and banked
+	 * per core, so acknowledge through GICC_IAR and end through GICC_EOIR
+	 * instead of the ICC_* system registers. TrustZone owns Group 0; every
+	 * interrupt this kernel handles is Group 1 and arrives as a normal IRQ.
+	 */
+	uint32_t iar = zenlte_gicc_read32(ZENLTE_GICC_IAR);
+	uint32_t intid = iar & 0x3FFU;
+
+	if (intid >= 1020U) {
+		return; /* spurious */
+	}
+	sweet_irq_total++;
+	if (intid == ZENLTE_VTIMER_INTID) {
+		sweet_irq_timer++;
+		sweet_kprof_sample(state);
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1; /* Large */
+		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
+		rtclock_intr(TRUE);
+		INTERRUPT_MASKED_DEBUG_END();
+		zenlte_gicc_write32(ZENLTE_GICC_EOIR, iar);
+	} else if (intid < 16U) {
+		sweet_irq_ipi++;
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Ack before handling so an IPI raised meanwhile is not lost */
+		zenlte_gicc_write32(ZENLTE_GICC_EOIR, iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+	} else {
+		sweet_irq_other++;
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		zenlte_gicc_write32(ZENLTE_GICC_EOIR, iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+#elif defined(SWEET)
 	/*
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..6f97a91 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -13,12 +13,14 @@
 #include <pexpert/arm64/board_config.h>
 
 
-#if HAS_GIC_V3
+#if HAS_GIC_V3 || defined(ZENLTE)
 #define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
 MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
 
-#if defined(SWEET)
-/* Phone default; QEMU virt wires the architected virtual timer to INTID 27. */
+#if defined(SWEET) || defined(ZENLTE)
+/* Phone default; QEMU virt wires the architected virtual timer to INTID 27.
+ * ZENLTE never evaluates this: its interrupt path is GIC-400, and the GICv3
+ * code below is unreachable (pe_init_fiq returns earlier). */
 SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
 #endif
 
@@ -79,6 +81,48 @@ pe_init_fiq()
 	int error;
 	DTEntry entry;
 
+#if defined(ZENLTE)
+	/*
+	 * Exynos 7420: GIC-400. This is a GICv2 part, so none of the GICv3 work
+	 * below applies: there are no redistributors to wake, no ICC_* system
+	 * registers, and no ARE_NS / EnableGrp1A bits. The whole init is four
+	 * memory-mapped register groups on fixed physical addresses taken from
+	 * the vendor device tree (exynos7420.dtsi).
+	 *
+	 * Group 0 belongs to TrustZone. Non-secure writes to it are ignored, so
+	 * this only ever touches Group 1, which then arrives as a normal IRQ.
+	 */
+	{
+		/* Distributor at 0x11001000: forward Group 1. */
+		zenlte_gicd_write32(ZENLTE_GICD_CTLR,
+		    zenlte_gicd_read32(ZENLTE_GICD_CTLR) | ZENLTE_GICD_CTLR_ENABLEGRP1);
+
+		/*
+		 * CPU interface at 0x11002000, banked per core: Group 1 on,
+		 * split EOI off (one write ends the interrupt), full priority
+		 * mask, binary point 0.
+		 */
+		zenlte_gicc_write32(ZENLTE_GICC_CTLR,
+		    (zenlte_gicc_read32(ZENLTE_GICC_CTLR) & ~ZENLTE_GICC_CTLR_EOIMODE)
+		    | ZENLTE_GICC_CTLR_ENABLEGRP1);
+		zenlte_gicc_write32(ZENLTE_GICC_PMR, 0xFF);
+		zenlte_gicc_write32(ZENLTE_GICC_BPR, 0);
+
+		/*
+		 * SGIs and PPIs share the low 32-bit bank of ISENABLER0 and of
+		 * the priority registers; a write here lands in this core's
+		 * bank. Enable the timer PPI and the IPI SGI.
+		 */
+		zenlte_gicd_write32(ZENLTE_GICD_IPRIORITYR + (ZENLTE_VTIMER_INTID & ~3U),
+		    0xA0A0A0A0);
+		zenlte_gicd_write32(ZENLTE_GICD_ISENABLER,
+		    (1U << ZENLTE_VTIMER_INTID) | (1U << ZENLTE_IPI_SGI));
+
+		__builtin_arm_isb(ISB_SY);
+	}
+	return;
+#endif /* ZENLTE */
+
 	// gicd_base is 0x0 only before it's initialized by the boot processor.
 	// Avoid calling SecureDT* routines on secondary processors to avoid
 	// race conditions because they are not thread-safe.
@@ -102,7 +146,7 @@ pe_init_fiq()
 			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
 		}
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(ZENLTE)
 		/* Read only on the boot CPU, before the GIC and RO-late lockdown. */
 		void const *timer_prop;
 		unsigned int timer_size;
diff --git a/pexpert/pexpert/arm64/zenlte.h b/pexpert/pexpert/arm64/zenlte.h
new file mode 100644
index 0000000..a4914c4
--- /dev/null
+++ b/pexpert/pexpert/arm64/zenlte.h
@@ -0,0 +1,101 @@
+/*
+ * Samsung Exynos 7420 (Galaxy S6 / S6 Edge / S6 Edge+ / Note 5).
+ *
+ * GIC-400 (GICv2), ARMv8.0-A, 24 MHz architected timer.
+ *
+ * Every address is from the vendor kernel device tree:
+ * samsungexynos7420/android_kernel_samsung_universal7420,
+ * arch/arm64/boot/dts/exynos7420.dtsi.
+ *
+ * Untested on hardware.
+ */
+#ifndef _PEXPERT_ARM64_ZENLTE_H_
+#define _PEXPERT_ARM64_ZENLTE_H_
+
+#define ZENLTE                            1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__                      8
+#define __ARM_VMSA__                      8
+#define __ARM_VFP__                       4
+#define __ARM_COHERENT_CACHE__            1
+#define __ARM_DEBUG__                     7
+#define __ARM_ENABLE_SWAP__               1
+#define __ARM_16K_PG__                    1
+
+/*
+ * GICv2. No redistributors: the CPU interface is one frame, banked per core.
+ * Group 0 belongs to TrustZone, so everything the kernel owns is Group 1 and
+ * arrives as a normal IRQ.
+ */
+#define HAS_GIC_V2                        1
+
+/*
+ * Architected timer PPIs in the vendor numbering:
+ *   <1 13> secure physical, <1 14> non-secure physical,
+ *   <1 11> virtual,         <1 10> hypervisor.
+ * XNU drives the physical timer: INTID 14.
+ */
+#define ZENLTE_VTIMER_INTID               14
+/* Only so the unreachable GICv3 initialisers still compile under ZENLTE. */
+#define SWEET_VTIMER_INTID                ZENLTE_VTIMER_INTID
+#define SWEET_IPI_SGI                     ZENLTE_IPI_SGI
+#define ZENLTE_IPI_SGI                    1
+#define ZENLTE_SPURIOUS_INTID             1023
+
+/* GIC-400 frames (exynos7420.dtsi gic node) */
+#define ZENLTE_GICD_PA                    0x11001000UL
+#define ZENLTE_GICC_PA                    0x11002000UL
+
+/* GICv2 register offsets (Arm IHI 0048) */
+#define ZENLTE_GICD_CTLR                  0x0000
+#define ZENLTE_GICD_TYPER                 0x0004
+#define ZENLTE_GICD_IGROUPR               0x0080
+#define ZENLTE_GICD_ISENABLER             0x0100
+#define ZENLTE_GICD_ICENABLER             0x0180
+#define ZENLTE_GICD_ICPENDR               0x0280
+#define ZENLTE_GICD_IPRIORITYR            0x0400
+#define ZENLTE_GICD_ITARGETSR             0x0800
+#define ZENLTE_GICD_SGIR                  0x0F00
+#define ZENLTE_GICC_CTLR                  0x0000
+#define ZENLTE_GICC_PMR                   0x0004
+#define ZENLTE_GICC_BPR                   0x0008
+#define ZENLTE_GICC_IAR                   0x000C
+#define ZENLTE_GICC_EOIR                  0x0010
+
+/* GIC-400 control bits. There is no ARE_NS and no RWP. */
+#define ZENLTE_GICD_CTLR_ENABLEGRP0       0x1
+#define ZENLTE_GICD_CTLR_ENABLEGRP1       0x2
+#define ZENLTE_GICC_CTLR_ENABLEGRP0       0x1
+#define ZENLTE_GICC_CTLR_ENABLEGRP1       0x2
+#define ZENLTE_GICC_CTLR_EOIMODE          0x2
+
+#ifndef ASSEMBLER
+
+static inline uint32_t
+zenlte_gicd_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(ZENLTE_GICD_PA + off);
+}
+
+static inline void
+zenlte_gicd_write32(uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(ZENLTE_GICD_PA + off) = val;
+}
+
+static inline uint32_t
+zenlte_gicc_read32(uint32_t off)
+{
+	return *(volatile uint32_t *)(ZENLTE_GICC_PA + off);
+}
+
+static inline void
+zenlte_gicc_write32(uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(ZENLTE_GICC_PA + off) = val;
+}
+
+#endif /* !ASSEMBLER */
+
+#endif /* ! _PEXPERT_ARM64_ZENLTE_H_ */
