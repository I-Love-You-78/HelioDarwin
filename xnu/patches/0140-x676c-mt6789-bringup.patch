diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 424e1c0..d781db8 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -46,9 +46,28 @@
 /*
  * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
- * (CNTV) is INTID 16 + 3 = 19.
+ * (CNTV) is INTID 16 + 3 = 19. Default only: the ADT's gic
+ * virtual-timer-intid overrides it (x676c: 27, standard PPI 11).
  */
 #define SWEET_VTIMER_INTID        19
+
+/*
+ * x676c (Infinix X676C, MediaTek MT6789). The early console and the pstore
+ * mirror reach physical memory through one 32MB L2 block each (16K pages),
+ * VA=PA under the bootstrap TTBR0 and at fixed kernel VAs afterwards.
+ *  - EARLY_FB: OVL0 L1, the opaque splash layer LK leaves on the panel;
+ *    the shim's display pump on CPU 0x700 pushes it to the command-mode glass.
+ *  - PSTORE: ramoops console zone (mem 0x48090000, console 0x40000); the
+ *    next Android boot shows it as /sys/fs/pstore/console-ramoops-0.
+ * Both blocks also contain TrustZone carve-outs (tkv-reserved 0xffff7000,
+ * BL31 0x48200000), so they are mapped Device-nGnRnE: never speculated.
+ */
+#define SWEET_EARLY_BLOCK_SIZE    0x2000000
+#define SWEET_EARLY_FB_PA         0xfeabe000
+#define SWEET_EARLY_FB_BLOCK      0xfe000000
+#define SWEET_PSTORE_PA           0x4811f000
+#define SWEET_PSTORE_SIZE         0x40000
+#define SWEET_PSTORE_BLOCK        0x48000000
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
