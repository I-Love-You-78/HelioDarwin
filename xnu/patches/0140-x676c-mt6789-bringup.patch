+	early_fb = (volatile uint32_t *)(uintptr_t)(base + (SWEET_EARLY_FB_PA - SWEET_EARLY_FB_BLOCK));
+	pstore = (volatile uint32_t *)(uintptr_t)(base + SWEET_EARLY_BLOCK_SIZE +
+	    (SWEET_PSTORE_PA - SWEET_PSTORE_BLOCK));
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
