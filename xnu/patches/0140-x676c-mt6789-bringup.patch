 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
- * per-CPU state: panic() can reach this before a current thread exists.
- * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
- * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
- * retain this console until the normal framebuffer serial console is ready.
+ * Bootstrap console. No allocation, locks, ADT parsing or per-CPU state:
+ * panic() can reach this before a current thread exists.
+ * start.s maps the splash framebuffer and pstore blocks VA=PA as Device
+ * memory. arm_vm_init installs reserved kernel VA aliases before removing
+ * TTBR0; retain this console until the normal framebuffer serial console is
+ * ready. The pstore mirror stays for the whole boot (see sweet_pstore_putc).
  */
 #include <arm64/sweet_early.h>
 
@@ -11,7 +12,38 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_EARLY_FB_PA;
+
+/*
+ * x676c: everything the consoles print is also appended to the ramoops
+ * console zone, behind the shim's own log. Same ring discipline as Linux
+ * persistent_ram: header {sig, start = next write offset, size = valid
+ * bytes}, data after it. The next Android boot exposes it as
+ * /sys/fs/pstore/console-ramoops-0, which survives any hang or panic here.
+ */
+#define PSTORE_SIG 0x43474244u          /* PERSISTENT_RAM_SIG, "DBGC" */
+#define PSTORE_HDR 12u
+#define PSTORE_CAP (SWEET_PSTORE_SIZE - PSTORE_HDR)
+static volatile uint32_t *pstore = (volatile uint32_t *)(uintptr_t)SWEET_PSTORE_PA;
+
+void
+sweet_pstore_putc(char c)
+{
+	volatile uint32_t *hdr = pstore;
+	volatile char *data = (volatile char *)hdr + PSTORE_HDR;
+
+	if (hdr[0] != PSTORE_SIG || hdr[1] >= PSTORE_CAP || hdr[2] > PSTORE_CAP) {
+		hdr[0] = PSTORE_SIG;
+		hdr[1] = 0;
+		hdr[2] = 0;
+	}
+	uint32_t start = hdr[1];
+	data[start] = c;
+	hdr[1] = start + 1 == PSTORE_CAP ? 0 : start + 1;
+	if (hdr[2] < PSTORE_CAP) {
+		hdr[2] = hdr[2] + 1;
+	}
+}
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
@@ -45,6 +77,7 @@ sweet_early_putc(char c)
