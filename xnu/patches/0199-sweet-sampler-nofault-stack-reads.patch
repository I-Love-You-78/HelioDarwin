+/* A remote thread may switch/detach its stack while the task list is locked. */
+static bool
+sweet_sample_stack_read(thread_t thread, uint64_t base, uint64_t top,
+    uint64_t address, void *buffer, size_t size)
+{
+	if (address < base || address > top || size > top - address ||
+	    os_atomic_load(&thread->kernel_stack, relaxed) != base) {
+		return false;
+	}
+	/* Copy via valid physical translations, never dereference a remote stack VA. */
+	if (ml_nofault_copy((vm_offset_t)address, (vm_offset_t)buffer, size) != size) {
+		return false;
+	}
+	return os_atomic_load(&thread->kernel_stack, relaxed) == base;
+}
