+#if !CONFIG_PROTECT
+/* Called with the attributes B-tree locked. Check keys, not xattr payloads:
+ * malformed protection data must not be mistaken for an absent attribute. */
+static bool
+sweet_hfs_cprotect_absent(struct hfsmount *hfsmp, uint32_t fileid,
+    BTreeIterator *iterator)
+{
+	static const char name[] = "com.apple.system.cprotect";
+	HFSPlusAttrKey *key = (HFSPlusAttrKey *)&iterator->key;
+	int result;
+	size_t i;
+
+	bzero(iterator, sizeof(*iterator));
+	if (hfs_buildattrkey(fileid, name, key) != 0)
+		return false;
+	result = BTSearchRecord(VTOF(hfsmp->hfs_attribute_vp), iterator, NULL, NULL, NULL);
+	if (result != btNotFound)
+		return false; /* Found any record, or could not establish absence. */
+
+	/* Include orphaned nonzero-startBlock records of the same attribute. */
+	result = BTIterateRecord(VTOF(hfsmp->hfs_attribute_vp), kBTreeNextRecord,
+	    iterator, NULL, NULL);
+	if (result == btNotFound) /* Exported API maps empty/end to not-found. */
+		return true;
+	if (result != 0 || key->attrNameLen > kHFSMaxAttrNameLen || key->pad != 0 ||
+	    key->keyLength != kHFSPlusAttrKeyMinimumLength + key->attrNameLen * sizeof(uint16_t))
+		return false;
+	if (key->fileID != fileid || key->attrNameLen != sizeof(name) - 1)
+		return true;
+	for (i = 0; i < sizeof(name) - 1; i++) {
+		if (key->attrName[i] != (uint8_t)name[i])
+			return true;
+	}
+	return false;
+}
+
+/* The caller holds the file's shared/exclusive cnode lock, like getxattr.
+ * This reports only known unprotected regular files, never encryption support. */
+static bool
+sweet_hfs_file_is_unprotected(struct vnode *vp, struct hfsmount *hfsmp,
+    struct cnode *cp)
+{
+	BTreeIterator *iterator;
+	int lockflags;
+	bool absent;
+
+	if (vnode_vtype(vp) != VREG ||
+	    (cp->c_flag & (C_DELETED | C_NOEXISTS)) != 0 ||
+	    (hfsmp->hfs_flags & HFS_CS) != 0 ||
+	    (vfs_flags(hfsmp->hfs_mp) & MNT_CPROTECT) != 0 ||
+	    (hfsmp->vcbAtrb & (kHFSContentProtectionMask | kHFSVolumeInconsistentMask)) != 0 ||
+	    hfsmp->hfs_attribute_vp == NULL)
+		return false;
+	iterator = hfs_malloc_type(struct BTreeIterator);
+	if (iterator == NULL)
+		return false;
+	lockflags = hfs_systemfile_lock(hfsmp, SFL_ATTRIBUTE, HFS_SHARED_LOCK);
+	/* The content-protection volume record uses the special file ID 1. */
+	absent = sweet_hfs_cprotect_absent(hfsmp, 1, iterator) &&
+	    sweet_hfs_cprotect_absent(hfsmp, cp->c_fileid, iterator);
+	hfs_systemfile_unlock(hfsmp, lockflags);
+	hfs_free_type(iterator, struct BTreeIterator);
+	return absent;
+}
+#endif
 
