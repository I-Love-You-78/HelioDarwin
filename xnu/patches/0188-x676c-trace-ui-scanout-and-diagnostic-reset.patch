 #include <kern/clock.h>
 #include <sys/proc.h>
 
+/* Opt-in observations only: do not change the display programming sequence. */
+static bool
+sweet_fb_trace_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		enabled = 0;
+		(void)PE_parse_boot_argn("sweetfb_trace", &enabled, sizeof(enabled));
+	}
+	return enabled != 0;
+}
+
+static uint32_t
+sweet_fb_sample_hash(const uint8_t *pixels, uint32_t width, uint32_t height, uint32_t stride)
+{
+	uint32_t hash = 2166136261u;
+	for (uint32_t y = 0; y < 32; y++) {
+		const uint32_t *row = (const uint32_t *)(pixels + (uint64_t)(y * (uint64_t)height / 32) * stride);
+		for (uint32_t x = 0; x < 32; x++) {
+			hash = (hash ^ row[x * (uint64_t)width / 32]) * 16777619u;
+		}
+	}
+	return hash;
+}
+
+static void
+sweet_graphics_stub_trace(unsigned int service, uint32_t selector, IOExternalMethodArguments *args)
+{
+	static uint32_t logged[2];
+	if (!sweet_fb_trace_enabled() || service >= 2 || logged[service] >= 16 || args == NULL) {
+		return;
+	}
+	logged[service]++;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET GRAPHICS STUB: %s %s selector %u in %u/%llu out %u/%llu returns success without implementation\n",
+	    service == 0 ? "Mali" : "Scaler", name, selector,
+	    args->scalarInputCount, (unsigned long long)(args->structureInputDescriptor ?
+	    args->structureInputDescriptor->getLength() : args->structureInputSize),
+	    args->scalarOutputCount, (unsigned long long)(args->structureOutputDescriptor ?
+	    args->structureOutputDescriptor->getLength() : args->structureOutputSize));
+}
