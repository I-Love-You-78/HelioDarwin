 #include <pexpert/pexpert.h>
 
 extern task_t proc_task(proc_t);
@@ -26,6 +29,32 @@ extern void sweet_sample_start(void);
 
 static char sweet_sample_names[128];
 
+extern int sync_internal(void);
+
+/* Opt-in timed diagnostic boot; the normal boot has no reset deadline. */
+static void
+sweet_reboot_thread(void *arg, __unused wait_result_t wr)
+{
+	static int channel;
+	uint32_t seconds = (uint32_t)(uintptr_t)arg;
+	uint64_t deadline;
+	clock_interval_to_deadline(seconds, NSEC_PER_SEC, &deadline);
+	printf("SWEET BOOT: diagnostic reset armed for %u seconds\n", seconds);
+	while (mach_absolute_time() < deadline) {
+		(void)assert_wait_deadline(&channel, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	printf("SWEET BOOT: syncing filesystems before diagnostic reset\n");
+	(void)sync_internal();
+	printf("SWEET BOOT: diagnostic PSCI SYSTEM_RESET\n");
+	/* Same SMCCC convention and PSCI function as the shim; this path is diagnostic. */
+	register uint64_t x0 __asm__("x0") = 0x84000009;
+	__asm__ volatile("dsb sy; smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+	    "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	printf("SWEET BOOT: PSCI reset returned %lld\n", (int64_t)x0);
+}
+
 static bool
 sweet_sample_wanted(const char *name)
 {
@@ -87,6 +116,12 @@ void
 sweet_sample_start(void)
 {
 	thread_t thread;
+	uint32_t reboot_seconds = 0;
+	if (PE_parse_boot_argn("sweetreboot", &reboot_seconds, sizeof(reboot_seconds)) &&
+	    reboot_seconds > 0 && reboot_seconds <= 1800 &&
+	    kernel_thread_start(sweet_reboot_thread, (void *)(uintptr_t)reboot_seconds, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
