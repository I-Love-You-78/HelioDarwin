+void
+AppleCLCD::traceFrame(void)
+{
+	if (!sweet_board_x676c() || !sweet_fb_trace_enabled() || fPixels == 0) {
+		return;
+	}
+	uint32_t frame = ++fTraceFrames;
+	if (frame > 16) {
+		return;
+	}
+	static volatile uint32_t *ovl = NULL, *ovl2 = NULL;
+	if (ovl == NULL) ovl = (volatile uint32_t *)ml_io_map(0x14005000, 0x1000);
+	if (ovl2 == NULL) ovl2 = (volatile uint32_t *)ml_io_map(0x14006000, 0x1000);
+	IOLog("SWEET FB TRACE: frame %u panel 0x%llx hash 0x%08x DSI start 0x%x sta 0x%x intsta 0x%x cmdq 0x%x mutex 0x%x\n",
+	    frame, fPhys, sweet_fb_sample_hash((const uint8_t *)fPixels, fWidth, fHeight, fRowBytes),
+	    fMtkDsi ? fMtkDsi[0] : 0, fMtkDsi ? fMtkDsi[1] : 0,
+	    fMtkDsi ? fMtkDsi[3] : 0, fMtkDsi ? fMtkDsi[0xd00 / 4] : 0,
+	    fMtkMutex ? fMtkMutex[0x20 / 4] : 0);
+	if (ovl != NULL && ovl2 != NULL) {
+		IOLog("SWEET FB TRACE: OVL src 0x%x L0 0x%x/%u L1 0x%x/%u; OVL2 src 0x%x L0 0x%x/%u\n",
+		    ovl[0x2c / 4], ovl[0xf40 / 4], ovl[0x44 / 4], ovl[0xf60 / 4], ovl[0x64 / 4],
+		    ovl2[0x2c / 4], ovl2[0xf40 / 4], ovl2[0x44 / 4]);
+	}
+	if (frame != 1 && frame != 8 && frame != 16) {
+		return;
+	}
+	/* Small RGB565 thumbnails let the captured bytes distinguish a logo from UI. */
+	static const char hex[] = "0123456789abcdef";
+	for (uint32_t y = 0; y < 72; y++) {
+		const uint32_t *row = (const uint32_t *)(fPixels + (uint64_t)(y * (uint64_t)fHeight / 72) * fRowBytes);
+		char line[129];
+		for (uint32_t x = 0; x < 32; x++) {
+			uint32_t p = row[x * (uint64_t)fWidth / 32];
+			uint16_t rgb = (uint16_t)(((p >> 8) & 0xf800) | ((p >> 5) & 0x07e0) | ((p >> 3) & 0x001f));
+			for (uint32_t n = 0; n < 4; n++) line[x * 4 + n] = hex[(rgb >> (12 - n * 4)) & 15];
+		}
+		line[128] = 0;
+		IOLog("SWEET FBPIX %u %u %s\n", frame, y, line);
+	}
+}
