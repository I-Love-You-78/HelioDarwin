From 7629352916b2b7a400093bd8e557ec7ceaeada37 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 21:20:24 +0500
Subject: [PATCH] x676c: applem2scaler service and console gui takeover mute

---
 bsd/dev/mem.c                         | 12 ++++++
 iokit/Kernel/arm/SweetFramebuffer.cpp | 56 ++++++++++++++++++++++++---
 iokit/KernelConfigTables.cpp          |  5 +++
 osfmk/arm64/sweet_early.c             | 24 ++++++++----
 pexpert/arm/pe_serial.c               | 47 +++++++++++++++-------
 5 files changed, 116 insertions(+), 28 deletions(-)

diff --git a/bsd/dev/mem.c b/bsd/dev/mem.c
index e94645a..730774c 100644
--- a/bsd/dev/mem.c
+++ b/bsd/dev/mem.c
@@ -264,6 +264,18 @@ mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 					if (error) {
 						break;
 					}
+					if (c >= 22) {
+						int drop = 0;
+						for (int i = 0; i <= (int)c - 22; i++) {
+							if (!memcmp(buf + i, "AppleM2ScalerCSCDriver", 22)) {
+								drop = 1;
+								break;
+							}
+						}
+						if (drop) {
+							continue;
+						}
+					}
 					printf("|%s| %.*s%s", name, (int)c, buf,
 					    (c > 0 && buf[c - 1] == '\n') ? "" : "\n");
 					continue;
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 48ae2da..9cab548 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -253,6 +253,48 @@ class IOAcceleratorES : public IOService {
 };
 
 OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+/*
+ * AppleM2ScalerCSCDriver stub service and user client.
+ *
+ * IOSurfaceAccelerator in userland matches "AppleM2ScalerCSCDriver" to perform
+ * hardware image scaling / color space conversion. Providing this service
+ * satisfies IOServiceMatching("AppleM2ScalerCSCDriver"), eliminating the
+ * "IOServiceMatchingfailed for: AppleM2ScalerCSCDriver" log spam and enabling
+ * clean fallback / progression of the CoreAnimation display pipeline.
+ */
+class AppleM2ScalerCSCDriver : public IOService {
+	OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService);
+
+class AppleM2ScalerCSCDriverUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleM2ScalerCSCDriverUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE { terminate(); return kIOReturnSuccess; }
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE {
+		return kIOReturnSuccess;
+	}
+};
+
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriverUserClient, IOUserClient);
+
+bool
+AppleM2ScalerCSCDriver::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleM2ScalerCSCDriverUserClient");
+	registerService();
+	IOLog("SWEET SCALER: AppleM2ScalerCSCDriver registered\n");
+	return true;
+}
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
 class IOMobileFramebufferUserClient : public IOUserClient {
@@ -1072,10 +1114,12 @@ AppleCLCD::present(const uint8_t *rec)
 	fConsShown = false;
 	if (directPresent(rec)) {
 		if (!fConsolePaused) {
-			int quiet = 0;
 			fConsolePaused = true;
-			if (PE_parse_boot_argn("sweetfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			int force_console = 0;
+			PE_parse_boot_argn("sweetfb_console", &force_console, sizeof(force_console));
+			if (!force_console) {
 				sweet_console_muted = 1;
+				IOLog("SWEET FB: GUI takeover, text console muted\n");
 			}
 		}
 		return;
@@ -1095,12 +1139,12 @@ AppleCLCD::present(const uint8_t *rec)
 
 
 	if (!fConsolePaused) {
-		int quiet = 0;
 		fConsolePaused = true;
-		if (PE_parse_boot_argn("sweetfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
-			/* Not PE_initialize_console(kPEDisableScreen): its console switch
-			 * writes the read-only-late cons_ops_index and panics. */
+		int force_console = 0;
+		PE_parse_boot_argn("sweetfb_console", &force_console, sizeof(force_console));
+		if (!force_console) {
 			sweet_console_muted = 1;
+			IOLog("SWEET FB: GUI takeover, text console muted\n");
 		}
 	}
 
diff --git a/iokit/KernelConfigTables.cpp b/iokit/KernelConfigTables.cpp
index 92f3e26..8c90f3d 100644
--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -63,6 +63,11 @@ const char * gIOKernelConfigTables =
     "     'IOMatchCategory' = IOCoreSurfaceRoot;"
     "   },"
     "   {"
+    "     'IOClass'         = AppleM2ScalerCSCDriver;"
+    "     'IOProviderClass' = IOResources;"
+    "     'IOMatchCategory' = AppleM2ScalerCSCDriver;"
+    "   },"
+    "   {"
     "     'IOClass'         = AppleCLCD;"
     "     'IOProviderClass' = IOPlatformDevice;"
     "     'IONameMatch'     = 'sweet,display';"
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 7264df2..e5b48cb 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -67,6 +67,8 @@ sweet_pstore_putc(char c)
 #define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
 
 extern unsigned char iso_font[256 * 16];
+#define FBCON_MAX_PIXELS (1080 * 2400)
+extern uint32_t fbcon_shadow[FBCON_MAX_PIXELS];
 
 /* Initialized data must remain writable until disable, including panics. */
 static unsigned int early_row, early_col;
@@ -77,23 +79,28 @@ sweet_early_clear_row(void)
 {
 	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
 		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		uint32_t *line_shadow = fbcon_shadow + (early_row * EARLY_CELL_H + y) * EARLY_WIDTH;
 		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line_shadow[x] = 0xff000000u;
 			line[x] = 0xff000000u;
 		}
 	}
 }
 
-/* Shift the whole text area up one glyph row and clear the bottom, so the
- * console scrolls instead of wrapping back to the top. */
+/* Shift the whole text area up one glyph row and clear the bottom using the
+ * DRAM shadow buffer (zero uncached VRAM reads). */
 static void
 sweet_early_scroll(void)
 {
 	unsigned int top = (EARLY_ROWS - 1) * EARLY_CELL_H;
 	for (unsigned int y = 0; y < top; y++) {
 		volatile uint32_t *dst = EARLY_FB + y * EARLY_STRIDE;
-		volatile uint32_t *src = EARLY_FB + (y + EARLY_CELL_H) * EARLY_STRIDE;
+		uint32_t *dst_shadow = fbcon_shadow + y * EARLY_WIDTH;
+		const uint32_t *src_shadow = fbcon_shadow + (y + EARLY_CELL_H) * EARLY_WIDTH;
 		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
-			dst[x] = src[x];
+			uint32_t px = src_shadow[x];
+			dst_shadow[x] = px;
+			dst[x] = px;
 		}
 	}
 	early_row = EARLY_ROWS - 1;
@@ -113,7 +120,9 @@ sweet_early_putc(char c)
 		 * black screen instead of over the shim's boot splash. */
 		for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
 			volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE;
+			uint32_t *line_shadow = fbcon_shadow + y * EARLY_WIDTH;
 			for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+				line_shadow[x] = 0xff000000u;
 				line[x] = 0xff000000u;
 			}
 		}
@@ -137,12 +146,13 @@ sweet_early_putc(char c)
 	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
 	for (unsigned int gy = 0; gy < 16; gy++) {
 		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
-			volatile uint32_t *line = EARLY_FB +
-			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
-			    early_col * EARLY_CELL_W;
+			unsigned int y = early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy;
+			volatile uint32_t *line = EARLY_FB + y * EARLY_STRIDE + early_col * EARLY_CELL_W;
+			uint32_t *line_shadow = fbcon_shadow + y * EARLY_WIDTH + early_col * EARLY_CELL_W;
 			for (unsigned int gx = 0; gx < 8; gx++) {
 				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
 				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line_shadow[gx * EARLY_SCALE + sx] = pixel;
 					line[gx * EARLY_SCALE + sx] = pixel;
 				}
 			}
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 80f6a6b..636199e 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -717,15 +717,26 @@ extern unsigned char iso_font[256 * 16];
 #define FBCON_FG        0xffffffffu
 #define FBCON_BG        0xff000000u
 #define FBCON_MAX_PIXELS (1080 * 2400)
+#define FBCON_GRID_MAX_COLS 136
+#define FBCON_GRID_MAX_ROWS 150
+
+extern int sweet_console_muted;
 
 static volatile uint32_t *fbcon_base;
 static uint32_t fbcon_width, fbcon_height, fbcon_stride;
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
-static uint32_t fbcon_shadow[FBCON_MAX_PIXELS] __attribute__((aligned(64)));
+uint32_t fbcon_shadow[FBCON_MAX_PIXELS] __attribute__((aligned(64)));
+static uint8_t fbcon_char_grid[FBCON_GRID_MAX_ROWS][FBCON_GRID_MAX_COLS];
 
 static void
 fbcon_clear_row(uint32_t row)
 {
+	if (sweet_console_muted) {
+		return;
+	}
+	if (row < FBCON_GRID_MAX_ROWS) {
+		bzero(&fbcon_char_grid[row], sizeof(fbcon_char_grid[row]));
+	}
 	uint32_t stride_u64 = fbcon_stride / 8;
 	uint32_t width_u64 = fbcon_width / 2;
 	uint64_t bg64 = ((uint64_t)FBCON_BG << 32) | FBCON_BG;
@@ -745,6 +756,9 @@ fbcon_clear_row(uint32_t row)
 static void
 fbcon_scroll(void)
 {
+	if (sweet_console_muted) {
+		return;
+	}
 	uint32_t cell_h = 16 * FBCON_SCALE;
 	uint32_t top = (fbcon_rows - 1) * cell_h;
 	uint32_t stride_u64 = fbcon_stride / 8;
@@ -753,16 +767,16 @@ fbcon_scroll(void)
 	volatile uint64_t *base64 = (volatile uint64_t *)fbcon_base;
 	uint64_t *shadow64 = (uint64_t *)fbcon_shadow;
 
-	/* 1. Fast scroll inside cached DRAM shadow buffer (L1/L2 hits) */
-	for (uint32_t y = 0; y < top; y++) {
-		uint64_t *dst = shadow64 + y * width_u64;
-		const uint64_t *src = shadow64 + (y + cell_h) * width_u64;
-		for (uint32_t x = 0; x < width_u64; x++) {
-			dst[x] = src[x];
-		}
+	/* 1. Fast scroll Character Grid in L1 cache (5 KB) */
+	if (fbcon_rows > 1 && fbcon_rows <= FBCON_GRID_MAX_ROWS) {
+		bcopy(&fbcon_char_grid[1], &fbcon_char_grid[0], (fbcon_rows - 1) * sizeof(fbcon_char_grid[0]));
+		bzero(&fbcon_char_grid[fbcon_rows - 1], sizeof(fbcon_char_grid[0]));
 	}
 
-	/* 2. Clear bottom row in shadow buffer */
+	/* 2. Fast scroll inside cached DRAM shadow buffer (L1/L2 hits) */
+	bcopy((const void *)(shadow64 + cell_h * width_u64), (void *)shadow64, (size_t)top * width_u64 * 8);
+
+	/* 3. Clear bottom row in shadow buffer */
 	for (uint32_t y = top; y < top + cell_h && y < fbcon_height; y++) {
 		uint64_t *dst = shadow64 + y * width_u64;
 		for (uint32_t x = 0; x < width_u64; x++) {
@@ -770,13 +784,9 @@ fbcon_scroll(void)
 		}
 	}
 
-	/* 3. Stream shadow buffer to physical VRAM (Zero uncached reads!) */
+	/* 4. Stream shadow buffer to physical VRAM using memcpy (fast vector writes) */
 	for (uint32_t y = 0; y < top + cell_h && y < fbcon_height; y++) {
-		volatile uint64_t *dst_vram = base64 + y * stride_u64;
-		const uint64_t *src_shadow = shadow64 + y * width_u64;
-		for (uint32_t x = 0; x < width_u64; x++) {
-			dst_vram[x] = src_shadow[x];
-		}
+		memcpy((void *)(base64 + y * stride_u64), (const void *)(shadow64 + y * width_u64), width_u64 * 8);
 	}
 
 	fbcon_row = fbcon_rows - 1;
@@ -814,6 +824,9 @@ fbcon_transmit_ready(void)
 static void
 fbcon_transmit_data(uint8_t c)
 {
+	if (sweet_console_muted) {
+		return;
+	}
 	if (c == '\r') {
 		fbcon_col = 0;
 		return;
@@ -825,6 +838,10 @@ fbcon_transmit_data(uint8_t c)
 	if (fbcon_col >= fbcon_cols) {
 		fbcon_newline();
 	}
+	if (fbcon_row < fbcon_rows && fbcon_col < fbcon_cols &&
+	    fbcon_row < FBCON_GRID_MAX_ROWS && fbcon_col < FBCON_GRID_MAX_COLS) {
+		fbcon_char_grid[fbcon_row][fbcon_col] = c;
+	}
 	const unsigned char *glyph = iso_font + c * 16;
 	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
 	uint32_t stride_px = fbcon_stride / 4;
