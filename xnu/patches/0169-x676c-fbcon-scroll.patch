From ccb46e60932a533c6de8826db355f01b8cb59332 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 19:12:21 +0500
Subject: [PATCH] x676c: scroll the framebuffer console instead of wrapping

The pe_serial framebuffer console (sweet_fbcon) advanced rows with
(fbcon_row + 1) % fbcon_rows, wrapping back to the top and clearing old
lines once the screen filled. When kprintf activity quieted down in
userland, the screen remained frozen on the last drawn state.

Implement 64-bit row scrolling (fbcon_scroll) when reaching the bottom
row, shifting lines up by one glyph row (32 scanlines) and clearing the
new bottom line, keeping output scrolling continuously.
---
 pexpert/arm/pe_serial.c | 40 ++++++++++++++++++++++++++++++++++------
 1 file changed, 34 insertions(+), 6 deletions(-)

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 19f27cd..56cf401 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -724,21 +724,49 @@ static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
 static void
 fbcon_clear_row(uint32_t row)
 {
+	uint32_t stride_u64 = fbcon_stride / 8;
+	uint32_t width_u64 = fbcon_width / 2;
+	uint64_t bg64 = ((uint64_t)FBCON_BG << 32) | FBCON_BG;
+	volatile uint64_t *base64 = (volatile uint64_t *)fbcon_base;
+
 	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
-		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
-		for (uint32_t x = 0; x < fbcon_width; x++) {
-			line[x] = FBCON_BG;
+		volatile uint64_t *line = base64 + y * stride_u64;
+		for (uint32_t x = 0; x < width_u64; x++) {
+			line[x] = bg64;
 		}
 	}
 }
 
+static void
+fbcon_scroll(void)
+{
+	uint32_t cell_h = 16 * FBCON_SCALE;
+	uint32_t top = (fbcon_rows - 1) * cell_h;
+	uint32_t stride_u64 = fbcon_stride / 8;
+	uint32_t width_u64 = fbcon_width / 2;
+	volatile uint64_t *base64 = (volatile uint64_t *)fbcon_base;
+
+	for (uint32_t y = 0; y < top; y++) {
+		volatile uint64_t *dst = base64 + y * stride_u64;
+		volatile uint64_t *src = base64 + (y + cell_h) * stride_u64;
+		for (uint32_t x = 0; x < width_u64; x++) {
+			dst[x] = src[x];
+		}
+	}
+	fbcon_row = fbcon_rows - 1;
+	fbcon_clear_row(fbcon_row);
+}
+
 static void
 fbcon_newline(void)
 {
 	fbcon_col = 0;
-	fbcon_row = (fbcon_row + 1) % fbcon_rows;
-	fbcon_clear_row(fbcon_row);
-	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+	if (fbcon_row + 1 >= fbcon_rows) {
+		fbcon_scroll();
+	} else {
+		fbcon_row++;
+		fbcon_clear_row(fbcon_row);
+	}
 }
 
 static void
