From add2eb1fc7bad0ddbd427b01e5107cd471258454 Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 23:49:22 +0500
Subject: [PATCH] x676c: mute video console, clear fb on GUI takeover, and
 register SweetMaliUserClient

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 51 ++++++++++++++++++++-------
 osfmk/console/video_console.c         |  7 ++++
 2 files changed, 45 insertions(+), 13 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 9cab548..fbd4add 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -254,6 +254,23 @@ class IOAcceleratorES : public IOService {
 
 OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
 
+/*
+ * SweetMaliUserClient stub for Mali-G57 Metal accelerator.
+ * Handles IOServiceOpen from Metal.framework / QuartzCore.
+ */
+class SweetMaliUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetMaliUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE { terminate(); return kIOReturnSuccess; }
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE {
+		return kIOReturnSuccess;
+	}
+};
+
+OSDefineMetaClassAndStructors(SweetMaliUserClient, IOUserClient);
+
 /*
  * AppleM2ScalerCSCDriver stub service and user client.
  *
@@ -512,19 +529,17 @@ AppleCLCD::start(IOService *provider)
 					    gpu_id, (gpu_id >> 16) & 0xff, (gpu_id >> 12) & 0xf,
 					    l2_feat, tiler_feat, mem_feat, mmu_feat, as_present, js_present);
 
-					/* Only register accelerator if hardware returned a valid, responding GPU ID */
-					if (gpu_id != 0 && gpu_id != ~0u) {
-						accel->setProperty("MetalPluginName", "MaliMetal");
-						accel->setProperty("MetalPluginClassName", "MaliMetalDevice");
-						accel->setProperty("IOGPUResourcePolicy", 1ULL, 32);
-						accel->setProperty("vendor-id", 0x13b5ULL, 32);
-						accel->setProperty("device-id", (unsigned long long)gpu_id, 32);
-						accel->setProperty("gpu-core-count", 2ULL, 32);
-						IOLog("SWEET GPU: Mali-G57 registered as MaliMetal / MaliMetalDevice (vendor 0x13b5, device 0x%04x)\n",
-						    gpu_id >> 16);
-					} else {
-						IOLog("SWEET GPU: Mali-G57 not responding (ID=0x%08x), skipping accelerator registration\n", gpu_id);
-					}
+					/* Register Mali-G57 accelerator properties unconditionally for CoreAnimation */
+					uint64_t dev_id = (gpu_id != 0 && gpu_id != ~0u) ? (unsigned long long)gpu_id : 0x9093ULL;
+					accel->setProperty("MetalPluginName", "MaliMetal");
+					accel->setProperty("MetalPluginClassName", "MaliMetalDevice");
+					accel->setProperty("IOGPUResourcePolicy", 1ULL, 32);
+					accel->setProperty("vendor-id", 0x13b5ULL, 32);
+					accel->setProperty("device-id", dev_id, 32);
+					accel->setProperty("gpu-core-count", 2ULL, 32);
+					accel->setProperty(kIOUserClientClassKey, "SweetMaliUserClient");
+					IOLog("SWEET GPU: Mali-G57 registered as MaliMetal / MaliMetalDevice (vendor 0x13b5, device 0x%04llx)\n",
+					    dev_id & 0xffff);
 				}
 			}
 #endif
@@ -1120,6 +1135,9 @@ AppleCLCD::present(const uint8_t *rec)
 			if (!force_console) {
 				sweet_console_muted = 1;
 				IOLog("SWEET FB: GUI takeover, text console muted\n");
+				if (sweet_board_x676c() && fPixels != 0) {
+					bzero((void *)fPixels, (size_t)fRowBytes * fHeight);
+				}
 			}
 		}
 		return;
@@ -1145,6 +1163,9 @@ AppleCLCD::present(const uint8_t *rec)
 		if (!force_console) {
 			sweet_console_muted = 1;
 			IOLog("SWEET FB: GUI takeover, text console muted\n");
+			if (sweet_board_x676c() && fPixels != 0) {
+				bzero((void *)fPixels, (size_t)fRowBytes * fHeight);
+			}
 		}
 	}
 
@@ -1212,6 +1233,10 @@ AppleCLCD::present(const uint8_t *rec)
 		    (uint64_t)(sx + w) * 4;
 		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
 		    s->memory == NULL || last > s->memory->getLength()) {
+			if (sweet_board_x676c()) {
+				IOLog("SWEET FB: copy skipped: w=%d h=%d mem=%p len=%llu last=%llu\n",
+				    w, h, s->memory, s->memory ? (unsigned long long)s->memory->getLength() : 0, (unsigned long long)last);
+			}
 			src = 0;
 		}
 		if (src != 0 && bpe == 4) {
diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
index 4193f57..6f6075d 100644
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -1250,6 +1250,13 @@ gc_update_color(int color, boolean_t fore)
 void
 vcputc_options(char c, __unused bool poll)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	extern int sweet_console_muted;
+	extern int panic_active(void);
+	if (sweet_console_muted && !panic_active()) {
+		return;
+	}
+#endif
 	if (gc_initialized && gc_enabled) {
 		VCPUTC_LOCK_LOCK();
 		if (gc_enabled) {
-- 
2.51.0.windows.1

