From b7a6f311f06c58d37c560bdfcf97a5cbcbc8c7ab Mon Sep 17 00:00:00 2001
From: Egor Kulikovskiy <xianel0x@gmail.com>
Date: Thu, 22 Oct 2026 03:37:28 +0500
Subject: [PATCH] x676c: report SCTLR.SPAN and the faulting SPSR.PAN

The SPAN=1 fix did not stop the copyin permission-fault storm, so confirm
the actual state: print SCTLR_EL1.SPAN (did the bit take, or did
pinst_set_sctlr strip it) and the faulting context's SPSR.PAN (was PAN
already 1, so SPAN=1 'leave unchanged' kept it set). That decides whether
to force SPAN or to explicitly clear PSTATE.PAN.
---
 osfmk/arm64/sleh.c     |  5 +++--
 osfmk/kern/exception.c | 11 +++++------
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 6fc9fda..ba42d79 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -262,7 +262,7 @@ extern unsigned int gFastIPI;
 /* Bring-up: count IRQs taken so the sampler can tell whether the vtimer
  * (and thus scheduler wakeups) is actually firing. */
 volatile uint64_t sweet_irq_total, sweet_irq_timer, sweet_irq_ipi, sweet_irq_other;
-volatile uint64_t sweet_last_esr, sweet_last_far, sweet_fault_count;
+volatile uint64_t sweet_last_esr, sweet_last_far, sweet_fault_count, sweet_last_spsr;
 
 /*
  * Bring-up profiler: the stuck thread is TH_RUN (spinning in the kernel),
@@ -696,11 +696,12 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 	/* Bring-up: remember the last data/instruction abort so the sampler can
 	 * report its ESR (fault status code: access flag vs translation vs
 	 * permission) and FAR without printing on every fault. */
-	extern volatile uint64_t sweet_last_esr, sweet_last_far, sweet_fault_count;
+	extern volatile uint64_t sweet_last_esr, sweet_last_far, sweet_fault_count, sweet_last_spsr;
 	if (class == ESR_EC_DABORT_EL0 || class == ESR_EC_DABORT_EL1 ||
 	    class == ESR_EC_IABORT_EL0 || class == ESR_EC_IABORT_EL1) {
 		sweet_last_esr = esr;
 		sweet_last_far = far;
+		sweet_last_spsr = get_saved_state_cpsr(state); /* bit 22 = PAN */
 		sweet_fault_count++;
 	}
 #endif
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 2891f28..cd5da14 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1021,13 +1021,12 @@ sweet_sample_task(const char *name, int pid, task_t task)
 		    sweet_irq_total, sweet_irq_timer, sweet_irq_ipi, sweet_irq_other,
 		    mach_absolute_time());
 
-		extern volatile uint64_t sweet_last_esr, sweet_last_far, sweet_fault_count;
-		uint64_t tcr = __builtin_arm_rsr64("TCR_EL1");
-		uint64_t mmfr1 = __builtin_arm_rsr64("ID_AA64MMFR1_EL1");
-		/* TCR_EL1.HA = bit 39, HD = bit 40; ID_AA64MMFR1.HAFDBS = bits[3:0] */
-		printf("SMP fault esr=0x%llx far=0x%llx cnt=%llu TCR.HA=%llu TCR.HD=%llu HAFDBS=%llu\n",
+		extern volatile uint64_t sweet_last_esr, sweet_last_far, sweet_fault_count, sweet_last_spsr;
+		uint64_t sctlr = __builtin_arm_rsr64("SCTLR_EL1");
+		/* SCTLR_EL1.SPAN = bit 23; faulting SPSR.PAN = bit 22 */
+		printf("SMP fault esr=0x%llx far=0x%llx cnt=%llu SCTLR.SPAN=%llu fault_spsr=0x%llx fault.PAN=%llu\n",
 		    sweet_last_esr, sweet_last_far, sweet_fault_count,
-		    (tcr >> 39) & 1, (tcr >> 40) & 1, mmfr1 & 0xf);
+		    (sctlr >> 23) & 1, sweet_last_spsr, (sweet_last_spsr >> 22) & 1);
 
 		extern uint64_t sweet_kprof_pc[], sweet_kprof_cnt[];
 		extern uint64_t sweet_kprof_stack[];
-- 
